# ============================================================================
# Aragon Trading — 环境变量示例 (.env.example)
# 复制为 services/quant/.env (后端) 与 apps/web/.env.local (前端) 后填值。
# 安全提示 (spec §12 C7): 切勿把真实 API 密钥提交进仓库。.env 已被 .gitignore 排除。
# 本期 (Phase 1) 仅使用 OKX 公共行情，OKX_* 凭据可全部留空。
# ============================================================================

# ---- 前端 (apps/web) ----
# 端口刻意选用不常用值（后端 18760 / 前端 18761），避开 3000/8000 等常见占用。
# Next.js 反向代理目标：把 /api/py/* 转发到 Python 后端
PY_BACKEND_URL=http://localhost:18760
# 浏览器直连 Python WebSocket 的基址
NEXT_PUBLIC_PY_WS_URL=ws://localhost:18760

# ---- 后端 (services/quant) ----
# OKX 私有接口凭据 —— 本期不使用，留空即可。
# ⚠️ 切勿粘贴真实密钥；若曾在别处明文出现，请视为已泄露并轮换 (spec R3)。
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# 访问 OKX 的代理（本机检测到 Clash: 127.0.0.1:7897）。httpx/websockets 透传。
HTTP_PROXY=http://127.0.0.1:7897
HTTPS_PROXY=http://127.0.0.1:7897
# ALL_PROXY=socks5://127.0.0.1:7897

# OKX 端点（一般无需修改）
OKX_REST_BASE=https://www.okx.com
# OKX V5 公共行情分两个 WS 端点：trades/tickers/books5（盘口/成交/ticker）走 public，
# candle{bar} K 线走 business（互相订阅会回 60018 "channel doesn't exist"）。两者都要配。
OKX_WS_PUBLIC=wss://ws.okx.com:8443/ws/v5/public
OKX_WS_BUSINESS=wss://ws.okx.com:8443/ws/v5/business

# SQLite 数据文件路径（相对 services/quant 运行目录）
DB_PATH=aragon.db

# 默认标的 / 周期 / 初始资金
DEFAULT_INST=BTC-USDT-SWAP
DEFAULT_BAR=1H
INITIAL_CAPITAL=10000

# 仅开发用：是否允许在 OKX 不可达时回退到本地缓存样例（默认 false，生产/验收必须 false）
ALLOW_CACHED_FALLBACK=false

# 同时活跃的实时模拟会话上限
MAX_PAPER_SESSIONS=3

# ---- 实盘交易（LIVE_*，真实资金，spec §3）----
# 实盘下单总开关：默认已开启（true），下单 / 设杠杆写接口可用。
# ⚠️ 安全阀：设为 false 即一键回退「real trading disabled」安全姿态，写接口一律 403、仅可查看真实持仓 / 成交。
LIVE_TRADING_ENABLED=true
# 单笔下单名义价值本地上限（USDT），越界本地拦截；需放大须在此显式覆写。
LIVE_MAX_ORDER_NOTIONAL_USD=1000
# 合约默认保证金模式（cross | isolated）。
LIVE_DEFAULT_TD_MODE=cross
# 下单面板默认杠杆。
LIVE_DEFAULT_LEVERAGE=3

# ---- AI 自动交易 · 限价委托挂单（AI_TRADE_LIMIT_*，spec ai-trade-limit-orders §5.3）----
# 限价总闸：开启后 Agent 可在决策里给 orderType=limit + limitPrice 挂单，并用 cancel_order 撤回自己
# 未成交的挂单；仍可照旧市价委托。设为 false 即逐字回退到 market-only（Agent 看不到这些字段）。
AI_TRADE_LIMIT_ORDERS_ENABLED=true
# 本地价带门禁：|limitPx-lastPx|/lastPx 超此值即降级 hold 并要求 Agent 重新研判。
# 比 OKX 侧 ±5% 限价带更紧、先触发、不消耗 API 配额，用于挡住 LLM 的幻觉价。
AI_TRADE_LIMIT_PRICE_MAX_DEVIATION_PCT=0.02
# 挂单存活上限（秒）：到期自动撤销，避免永不成交的挂单长期占用保证金与会话预算。
AI_TRADE_LIMIT_ORDER_TTL_S=300

# ---- AI 自动交易 · 【基础策略】铁律层（AI_TRADE_BASE_RULE*，spec ai-trade-base-strategy-ma-band §5.3）----
# 基础策略总闸：无论用户选了哪些常规/组合/因子策略，开仓只允许发生在执行周期 MA 通道的上轨/中轨/下轨
# 附近（限价委托按**委托价**判定）。设为 false 即逐字回退到本特性合入前（不注入 prompt、不调门禁）。
AI_TRADE_BASE_RULES_ENABLED=true
# 中轨 SMA 周期与上下轨标准差倍数（通道 = MA(period) ± std_mult × σ）。
AI_TRADE_BASE_RULE_MA_PERIOD=20
AI_TRADE_BASE_RULE_MA_STD_MULT=2.0
# 「附近」的容差（带宽归一的 %B 距离，跨周期同义）：0.05 极严 / 0.15 标准 / 0.25 = 仅限带内（最宽松）。
AI_TRADE_BASE_RULE_BAND_TOLERANCE=0.15
# 方向性模式（做多只许下轨/中轨、做空只许上轨/中轨）：默认关，趋势突破类策略慎开。
AI_TRADE_BASE_RULE_DIRECTIONAL=false

# ---- AI 自动交易 · 成本记账与最小 edge 门禁（spec ai-trade-cost-accounting-and-edge-gate §5.1）----
# 本段只作用于 **AI 会话**：非 AI 的 live_auto 恒不注入费率账本，这些开关取任何值都不影响它。
# A0-1 记录层：每笔成交按确定性费率模型入账（notional × feeBps），实测费率只进归因、绝不回写盈亏。
AI_TRADE_FEE_ACCOUNTING_ENABLED=true
# A0-2 口径切换：平仓盈亏扣双边费用 ⇒ 会话盈亏变净额。**破坏性变更，默认关**；开启前请先确认
# 费率入账完整性达 100%（滚动 50 笔），并知悉历史数据与新口径不可比。
AI_TRADE_NET_PNL_ENABLED=false
# 腿费率（bps）：限价挂单成交按 maker、市价 / OCO / 外部平仓按 taker。刻意不复用回测世界的
# DEFAULT_TAKER_FEE_BPS —— 两个世界的成本假设必须能各自演进。
AI_TRADE_MAKER_FEE_BPS=2.0
AI_TRADE_TAKER_FEE_BPS=5.0
# 无盘口数据时的半价差保守假设与冲击成本常数（bps）。
AI_TRADE_HALF_SPREAD_FALLBACK_BPS=1.0
AI_TRADE_IMPACT_BPS=0.5
# 成本模型的预期持仓根数（资金费率结算周期数由它推）。
AI_TRADE_COST_EXPECTED_HOLD_BARS=8
# 最小 edge 门禁：毛 edge(bps) ≥ K_MIN × 往返成本(bps) 才允许开仓。**0 = 门禁空转（默认）**；
# 上线 runbook：先满 50 笔费率入账 → 开 A0-2 → 观察 100 笔 → 再置 2.0。
AI_TRADE_EDGE_GATE_K_MIN=0.0
# 成本估算降级（资金费率缺席）时的阈值收紧倍数。
AI_TRADE_EDGE_GATE_DEGRADED_MULT=1.2
# 粗估毛 edge 的 ATR 倍数（阶段一的 edge 分子是显式标注的粗估，非概率化先验）。
AI_TRADE_EDGE_ATR_TARGET_MULT=1.0
# 永续资金费率取数：关闭 ⇒ 资金费率项恒 0 且置信度保持 ok（有意选择 ≠ 数据缺失）。
AI_TRADE_FUNDING_ENABLED=true
AI_TRADE_FUNDING_POLL_TTL_S=60
# 实测成交明细旁路审计（校准模型费率 / 观测滑点）：只跑在 5s 盯市上，绝不进决策轮。
AI_TRADE_FILL_AUDIT_ENABLED=true
AI_TRADE_FILL_AUDIT_INTERVAL_S=60

# ---- AI 自动交易 · 信号先验体系与 EV 分子（AI_TRADE_PRIOR_* / 三总闸，spec ai-trade-signal-prior-and-ev-gate §七）----
# 三个默认关闭的独立总闸：全关时逐字节回退到阶段一行为。上线顺序 L1 → L2 → L3（见 spec §九 runbook）。
AI_TRADE_SIGNAL_PRIOR_ENABLED=false
AI_TRADE_WEIGHTED_CONSENSUS_ENABLED=false
# 总闸③开启前必须先把 AI_TRADE_EDGE_GATE_K_MIN 推上去（k_min=0 时门禁整体空转，开③什么都不会发生）。
AI_TRADE_EDGE_PRIOR_ENABLED=false
# 单条先验的可用性判据：事件数 / 独立事件段数（仅策略侧）/ 有效段数下限。
AI_TRADE_PRIOR_MIN_SAMPLES=30
AI_TRADE_PRIOR_MIN_RUNS=10
AI_TRADE_PRIOR_MIN_SEGMENTS=6
# 段级时间衰减半衰期（天）与段末隔离根数（0=关闭跨段隔离）。
AI_TRADE_PRIOR_DECAY_HALF_LIFE_DAYS=30
AI_TRADE_PRIOR_EMBARGO_BARS=12
# IR 权重上限（0 ⇒ 先验恒缺席，等价关闭）与 prompt 证据明细条数上限。
AI_TRADE_PRIOR_IR_CLIP=2.0
AI_TRADE_PRIOR_TOP_N=5
# 快照陈旧度门禁（秒，默认 7 天）：每 7 天须重建一次；改持有期或策略参数后必须立即重建。
AI_TRADE_PRIOR_MAX_AGE_S=604800
# rebuild 的缺省回看根数与取数前硬上限（越界即 413 AI_PRIOR_TOO_LARGE，绝不无界拉 K 线）。
AI_TRADE_PRIOR_LOOKBACK_BARS=4000
AI_TRADE_PRIOR_MAX_BARS=8000

# ---- AI 自动交易 · 唤醒感知上下文（AI_TRADE_TACTICAL_* / AI_TRADE_WAKE_*，spec ai-trade-wake-aware-context §4.2）----
# 轴 A：战术周期证据。定时唤醒轮过去拿到的行情证据与上一轮**逐字节相同**（信号板只在确认根重算），
# 模型被迫对同一份证据反复表态、只能反复 hold。补上「严格短于执行周期、贴唤醒节奏」的第三层时间尺度：
# 30m 执行 + 3 分钟唤醒 ⇒ 注入 1m/5m 的体制、指标与「自上轮收了几根」。false ⇒ 整键缺席 + prompt 逐字回退。
AI_TRADE_TACTICAL_CONTEXT=true
# 注入的战术周期数（0 等价关闭）；每周期窗口根数（默认 120；调低到 60 以下时 classify_regime 会
# 判不出体制，战术帧只剩证据摘要——这是可接受的降级，但别指望还能看到「体制背离」提示）。
AI_TRADE_TACTICAL_MAX_BARS=2
AI_TRADE_TACTICAL_WINDOW_BARS=120
# REST 刷新硬下限（秒，配额护栏防 429）与单次取数硬超时（秒）。后者护的是 5 秒盯市循环——同一个 tick
# 还守着利润保护棘轮与会话止损这些**真实资金**路径，交易所慢响应绝不能把它们挤停。
AI_TRADE_TACTICAL_MIN_REFRESH_S=20
AI_TRADE_TACTICAL_FETCH_TIMEOUT_S=8
# 战术段渲染字符上限（0=不截断）；超限会追加**可见**截断标记，绝不静默截断。
AI_TRADE_TACTICAL_MAX_CHARS=700
# 轴 B：唤醒原因。trigger 的二值扩成七种结构化 kind（新 K 线收盘 / 补看新 K 线 / 挂单盯守 / 浮盈跨档 /
# 价格异动 / 持仓盯市 / 心跳），同时驱动跳过守卫与 prompt 措辞，并落进 trades.explain_json.meta.wakeKind
# 供事后按唤醒来源切胜率。false ⇒ payload/prompt/事件/归因整体回退到二值 trigger。
AI_TRADE_WAKE_REASON_ENABLED=true
# 价格异动判据（×执行周期 ATR，经 √t 律折算到唤醒窗口的时间尺度）；0 ⇒ 逐字回退纯 pct 判据
# （AI_TRADE_WAKE_SKIP_UNCHANGED_PCT）。折算系数刻意不做成配置项：它是量纲折算而非调参旋钮。
AI_TRADE_WAKE_MOVE_ATR_MULT=0.5
# 连续跳过上限，到即强制放行一轮（饿死兜底）；0 = 不封顶。没有这条上界，静止行情下 AI 会变成事实
# 上的停机，而用户看不到任何原因。
AI_TRADE_WAKE_MAX_SKIP_STREAK=5
# 渐进式上下文披露：同一根执行 K 线的第 2 次及以后决策，把中线背景与执行周期证据压成压缩形态
# （最新变化改由战术周期承载）。false ⇒ 恒全量披露。
AI_TRADE_PROGRESSIVE_DISCLOSURE=true

# ---- AI 自动交易 · 唤醒调度闭环（AI_TRADE_WAKE_* / AI_TRADE_SIGNAL_WAKE_*，spec ai-trade-wake-scheduler-closed-loop §4.2）----
# 上一段解决的是「唤醒之后喂什么」，本段解决「何时唤醒、唤醒丢了怎么办、唤醒值不值」。
# 轴 A：唤醒补跑。上一轮 LLM 还在飞时到达的唤醒过去是**静默消失**（最坏一轮 ≈379 秒，1m/5m 周期下
# 能吞掉 6 根确认根，「恰好错过关键那根 K 线」由此而来）。改成记一笔待办，轮末用同一个分类器重判，
# 输入确实变了就立刻补跑一轮，并把「丢了几次、其中几根 K 线收线没被研判」如实写进 prompt。
# false ⇒ 只计数不补跑（观测保留，行为逐字回退）。
AI_TRADE_WAKE_BACKLOG_ENABLED=true
# 连续补跑上限（触顶即弃单并计一次 ceilingHits）。刻意**没有**「0=不封顶」：无上限的补跑链等于
# 无上限的 LLM 花费；「不补跑」由上一行的总闸表达。
AI_TRADE_WAKE_BACKLOG_MAX_CHAIN=3
# 轴 B：持仓轮唤醒经济学。持仓期间的退出已被 5 秒确定性层接管（利润保护棘轮只收紧不放松、会话级
# 止盈止损、交易所侧 OCO），AI 被叫醒后绝大多数轮次只能输出 hold——烧钱且给「观望」堆假证据。
# 允许跳过 position_watch 轮，但**只在利润保护快照处于 armed/breakeven_armed 时**：idle/unavailable
# 下 AI 是唯一退出路径，一次都不跳。false ⇒ 逐字回退「持仓轮永不跳过」。
AI_TRADE_WAKE_SKIP_POSITION_WATCH=true
# 持仓连续跳过上限，到即强制放行一轮（比空仓的 5 更紧）。同样没有「0=不封顶」——持仓期无限期不研判
# 是一个能亏真钱的状态。
AI_TRADE_WAKE_POSITION_WATCH_MAX_SKIP_STREAK=3
# 轴 C：信号驱动唤醒（**首发默认关**）。在未确认根上深拷贝一份策略与影子 broker 做无副作用预演，
# 只有「投影净共识立场」翻转且连续保持 hold_s 秒与 min_samples 次**有效**观测（行情确实变过才算）
# 才唤醒一次。翻转证据以 provisional 身份进 payload——信号板与全部门禁一律仍以确认根为准，故最坏
# 后果只是多烧一次 token。本轴是唯一会占用守着真实资金的 5 秒盯市 tick 与线程池的一条，故默认关闭。
AI_TRADE_SIGNAL_WAKE_ENABLED=false
# 防抖双条件（缺一不可）：只看时长，一次 15 秒间隔的采样就能「保持 45 秒」；只看次数，高频 tick 会
# 让它瞬间达标。min_samples 下限为 2——`hold_s=0 + min_samples=1` 是零防抖。
AI_TRADE_SIGNAL_WAKE_HOLD_S=45
AI_TRADE_SIGNAL_WAKE_MIN_SAMPLES=3
# 两次信号唤醒的最小间隔（LLM 花费上界）。
AI_TRADE_SIGNAL_WAKE_MIN_GAP_S=120
# 预演节流（≈每 3 个盯市 tick 一次）与单次预演硬超时。超时即退避（间隔翻倍，上限 300s）。
# 首次到期按 session_id 稳定哈希错峰，避免分组 N 个成员同时向线程池投 CPU 密集预演。
AI_TRADE_SIGNAL_WAKE_PREVIEW_INTERVAL_S=15
AI_TRADE_SIGNAL_WAKE_TIMEOUT_S=3
# 判定价新鲜度闸：距上次收到任意价格推送超过该秒数即不预演。没有它，一个静默的 WS 就能让
# 「该翻转已连续保持 45 秒」这句话在零新数据的情况下成立。
AI_TRADE_SIGNAL_WAKE_STALE_S=90

# ---- 波动率目标化仓位 + ATR 止损 + 相关性预算 + 回撤刹车（vol-sizing-and-drawdown-brake §4.4）----
# 四个相互独立、**默认全关**的总闸：全关时逐字节回退到阶段二第一步（commit c6db95d）的行为。
# 总闸①：波动率目标化仓位求解（f 由已实现波动率、胜率先验、edge 与成本共同解出，模型的
# sizeFraction 降级为「上限提议」，只会被调小、不会被调大）。
AI_TRADE_SIZING_ENABLED=false
AI_TRADE_VOL_TARGET_ANNUAL=0.20
# 已实现波动率回看根数（15m ⇒ 一整天）。注意：它 + 1 必须 <= 行情窗口容量，否则启动即 422
# AI_TRADE_SIZING_WINDOW_TOO_SMALL（窗口最小可到 80，默认 96 需要把 primingBars 调到 >= 97）。
AI_TRADE_REALIZED_VOL_WINDOW=96
# 凯利缩放（四分之一凯利）；0 = 凯利项整体不参与 min。赔率的 W/L 恒取本轮实际要挂的那对括号。
AI_TRADE_KELLY_LAMBDA=0.25
# 总闸②：ATR 止损倍数（**与总闸①独立**，runbook L1 只开这一个）；0 = 逐字回退固定百分比止损。
AI_TRADE_STOP_ATR_MULT=0.0
AI_TRADE_STOP_RR=2.0
# 总闸③：组合有效敞口上限（平均单标的满仓名义额的倍数），取值域 {0} 并 [1,10]，越界即启动 422。
AI_TRADE_EFFECTIVE_EXPOSURE_CAP_MULT=0.0
AI_TRADE_CORRELATION_MIN_SAMPLES=96
# 总闸④：三级刹车。**阈值必须按杠杆定标**——session_pnl 落在已含杠杆的名义额上，而回撤的分母是
# 保证金口径的预算，故 3x 杠杆下 8%/15% 等价于标的价反向 2.7%/5.0%。以 3x 为锚点按 x 3/leverage
# 折算：3x => 0.08 / 0.15；5x => 0.048 / 0.09。三档默认全关，合并即全关、逐级打开。
AI_TRADE_BRAKE_SLOW_DD_PCT=0.0
AI_TRADE_BRAKE_SLOW_SIZE_MULT=0.5
AI_TRADE_BRAKE_HALT_DD_PCT=0.0
AI_TRADE_BRAKE_LOSS_STREAK=0
AI_TRADE_BRAKE_LOSS_COOLDOWN_BARS=4.0

# ---- Agent（对话式 AI 助手）LLM 接入 ----
# AI 助手的模型接入，支持 anthropic / openai 两种标准；密钥仅存后端，绝不下发前端。
# ⚠️ 切勿在此处粘贴真实密钥（.env 才填真实值；.env 已被 .gitignore 排除）。
# 说明：下方这套 KIMI 服务会在首次初始化时被「设置中心 · AI 模型服务」作为内置默认服务自动种入，
#       之后可在 UI 中改 / 增 / 删服务并切换默认（库内非空即不再被 env 覆盖）。
AGENT_PROVIDER=anthropic
AGENT_BASE_URL=https://api.kimi.com/coding
AGENT_API_KEY=
# 任务显式指定 kimi-k2.6；docs/examples 已实测可用的回退值为 kimi-k2.5（model-not-found 时一行切回）。
AGENT_MODEL=kimi-k2.6
# KIMI Coding 端点校验 User-Agent，默认 claude-code/1.0（一般无需修改）。
AGENT_USER_AGENT=claude-code/1.0
# Agent LLM 独立代理：留空回落系统/OKX 代理；显式 none 强制直连。
# AGENT_PROXY=
# ---- 加固增强（iteration 2）：LLM 传输层有界重试 + 断连 drain 超时（一般无需修改）----
# pre-stream 重试上限（429/5xx/网络瞬断退避重试；最多 1+N 次尝试，0 即不重试）。
AGENT_MAX_RETRIES=2
# 指数退避基数（毫秒，第 i 次退避 base*2**i，封顶 max）。
AGENT_RETRY_BASE_MS=500
# 单次退避封顶（毫秒，亦为 Retry-After 整数秒解析上限）。
AGENT_RETRY_MAX_MS=8000
# 断连后等待 in-flight run 收束的兜底超时（秒）；超时即 cancel 孤儿，清理永不挂死。
AGENT_DRAIN_TIMEOUT_SECONDS=8.0
# ---- 韧性流式（iteration 3）：run/socket 解耦续流 + 心跳保活（一般无需修改）----
# 断连后 in-flight 回答的存活宽限（秒）：宽限内重连即续流，宽限耗尽才取消并落盘。
# 设为 0 即"断连立即取消"（回退迭代 2 行为，一键安全阀）。
AGENT_DETACH_GRACE_SECONDS=30.0
# run 期心跳间隔（秒）：保活长回测期间的 WS，须 < 中间层 idle 超时。
AGENT_HEARTBEAT_SECONDS=20.0
# 会话事件缓冲上限（条）：重连重放窗口；越大可覆盖越长的断连，内存占用越高（下限 64）。
AGENT_EVENT_BUFFER_SIZE=512

# ============================ 策略与因子挖掘（strategy-factor-discovery §六） ============================
# ⚠️ 三处联动缺一即静默失效：① services/quant/app/config.py 必须真的声明字段
#    （Settings extra="ignore" 会吞掉未声明的 env）；② desktop/src/lib/config.js 的 prod 白名单
#    必须放行 DISCOVERY_ 前缀；③ 本文件补文档。
# 总闸：false ⇒ 写类端点 403（读类仍可看历史），且**自动续跑一票否决**（重启后一律 paused）。
DISCOVERY_ENABLED=true
# 并发挖掘任务上限（硬上限 3）。启动第 N+1 个任务返回 409 DISCOVERY_BUSY。
DISCOVERY_MAX_RUNS=1
# 迭代间隔默认与夹紧区间（秒）。默认 300 对齐参考报告的「每 5 分钟一轮」。
DISCOVERY_DEFAULT_INTERVAL_S=300.0
DISCOVERY_MIN_INTERVAL_S=60.0
DISCOVERY_MAX_INTERVAL_S=3600.0
# 单轮候选上限与数据窗口根数上限（取数工作量护栏）。
DISCOVERY_MAX_CANDIDATES_PER_ITER=200
DISCOVERY_MAX_WINDOW_BARS=8000
# 单轮工作量上限（候选数 × 根数），超限即启动前 413 DISCOVERY_TOO_LARGE。
DISCOVERY_WORK_UNIT_LIMIT=3000000
# 单候选验证墙钟超时 / 单轮墙钟预算（秒）。到点停取新候选、正常提交已完成者并如实上报丢弃数。
DISCOVERY_CANDIDATE_TIMEOUT_S=20.0
DISCOVERY_ITERATION_TIMEOUT_S=600.0
# 验证层进线程池的并发信号量（硬上限 8）。线程池与所有 API 请求共用，调大会让交互式请求变慢。
DISCOVERY_VALIDATE_CONCURRENCY=2
# LLM 子代理（生成 + 审查）：总闸 / 超时 / 重试 / 每小时调用硬上限。
# 关掉或未配置模型服务时，循环退化为**纯演化搜索**，入库标准不变（fail-open）。
DISCOVERY_LLM_ENABLED=true
DISCOVERY_LLM_TIMEOUT_S=60.0
DISCOVERY_LLM_MAX_RETRIES=1
DISCOVERY_LLM_MAX_CALLS_PER_HOUR=24
# 每 run 的保留上限（kept 候选永不剪；只剪 rejected 与迭代记录，剪枝量如实上报）。
DISCOVERY_MAX_CANDIDATE_ROWS=20000
DISCOVERY_MAX_ITERATION_ROWS=5000
# WS 环形缓冲条数（终态事件单独持槽，绝不被挤掉）。
DISCOVERY_WS_RING=400
# 进程重启后自动续跑 running 任务。受 DISCOVERY_ENABLED 一票否决；续跑必先重建候选池。
DISCOVERY_AUTO_RESUME=true
# 自动续跑前的静置延时（秒），等 OKX / DB 就绪。
DISCOVERY_RESUME_DELAY_S=10.0
# ---- 三条策略轴（discovery-strategy-axes §六）----
# 单轮**底层 run_backtest 调用次数**硬顶（不是候选数：一个策略轮动候选背后是 4–12 次）。
# 触顶即截断本轮剩余候选并记 truncatedByBacktestCap，绝不静默。
DISCOVERY_MAX_BACKTESTS_PER_ITERATION=120
# 单个策略候选的墙钟超时（秒）——样本内 / 样本外 / 成本压力**三段合计**。
DISCOVERY_BACKTEST_TIMEOUT_S=30.0
# 一个挖掘任务允许取的高周期帧数上限；超出的模板整体退出可挖目录并写明原因。
DISCOVERY_MAX_HTF_FRAMES=3
# 因子组合轴的成员目录上限（超出按「本任务 kept → 既有挖掘因子 → 库内内置」截断并留痕）。
DISCOVERY_MEMBER_CATALOG_MAX=60
# 低于此规模的轴本轮跳过 FSA 扫描：池里只有 3 条时每条都占 33% > 15%，会被全部冻结。
DISCOVERY_FSA_MIN_POOL=20
