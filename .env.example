# ============================================================================
# Aragon Trading — 环境变量示例 (.env.example)
# 复制为 services/quant/.env (后端) 与 apps/web/.env.local (前端) 后填值。
# 安全提示 (spec §12 C7): 切勿把真实 API 密钥提交进仓库。.env 已被 .gitignore 排除。
# 本期 (Phase 1) 仅使用 OKX 公共行情，OKX_* 凭据可全部留空。
# ============================================================================

# ---- 前端 (apps/web) ----
# 端口刻意选用不常用值（后端 18760 / 前端 18761），避开 3000/8000 等常见占用。
# Next.js 反向代理目标：把 /api/py/* 转发到 Python 后端
PY_BACKEND_URL=http://localhost:18760
# 浏览器直连 Python WebSocket 的基址
NEXT_PUBLIC_PY_WS_URL=ws://localhost:18760

# ---- 后端 (services/quant) ----
# OKX 私有接口凭据 —— 本期不使用，留空即可。
# ⚠️ 切勿粘贴真实密钥；若曾在别处明文出现，请视为已泄露并轮换 (spec R3)。
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# 访问 OKX 的代理（本机检测到 Clash: 127.0.0.1:7897）。httpx/websockets 透传。
HTTP_PROXY=http://127.0.0.1:7897
HTTPS_PROXY=http://127.0.0.1:7897
# ALL_PROXY=socks5://127.0.0.1:7897

# OKX 端点（一般无需修改）
OKX_REST_BASE=https://www.okx.com
# OKX V5 公共行情分两个 WS 端点：trades/tickers/books5（盘口/成交/ticker）走 public，
# candle{bar} K 线走 business（互相订阅会回 60018 "channel doesn't exist"）。两者都要配。
OKX_WS_PUBLIC=wss://ws.okx.com:8443/ws/v5/public
OKX_WS_BUSINESS=wss://ws.okx.com:8443/ws/v5/business

# SQLite 数据文件路径（相对 services/quant 运行目录）
DB_PATH=aragon.db

# 默认标的 / 周期 / 初始资金
DEFAULT_INST=BTC-USDT-SWAP
DEFAULT_BAR=1H
INITIAL_CAPITAL=10000

# 仅开发用：是否允许在 OKX 不可达时回退到本地缓存样例（默认 false，生产/验收必须 false）
ALLOW_CACHED_FALLBACK=false

# 同时活跃的实时模拟会话上限
MAX_PAPER_SESSIONS=3

# ---- 实盘交易（LIVE_*，真实资金，spec §3）----
# 实盘下单总开关：默认已开启（true），下单 / 设杠杆写接口可用。
# ⚠️ 安全阀：设为 false 即一键回退「real trading disabled」安全姿态，写接口一律 403、仅可查看真实持仓 / 成交。
LIVE_TRADING_ENABLED=true
# 单笔下单名义价值本地上限（USDT），越界本地拦截；需放大须在此显式覆写。
LIVE_MAX_ORDER_NOTIONAL_USD=1000
# 合约默认保证金模式（cross | isolated）。
LIVE_DEFAULT_TD_MODE=cross
# 下单面板默认杠杆。
LIVE_DEFAULT_LEVERAGE=3

# ---- AI 自动交易 · 限价委托挂单（AI_TRADE_LIMIT_*，spec ai-trade-limit-orders §5.3）----
# 限价总闸：开启后 Agent 可在决策里给 orderType=limit + limitPrice 挂单，并用 cancel_order 撤回自己
# 未成交的挂单；仍可照旧市价委托。设为 false 即逐字回退到 market-only（Agent 看不到这些字段）。
AI_TRADE_LIMIT_ORDERS_ENABLED=true
# 本地价带门禁：|limitPx-lastPx|/lastPx 超此值即降级 hold 并要求 Agent 重新研判。
# 比 OKX 侧 ±5% 限价带更紧、先触发、不消耗 API 配额，用于挡住 LLM 的幻觉价。
AI_TRADE_LIMIT_PRICE_MAX_DEVIATION_PCT=0.02
# 挂单存活上限（秒）：到期自动撤销，避免永不成交的挂单长期占用保证金与会话预算。
AI_TRADE_LIMIT_ORDER_TTL_S=300

# ---- Agent（对话式 AI 助手）LLM 接入 ----
# AI 助手的模型接入，支持 anthropic / openai 两种标准；密钥仅存后端，绝不下发前端。
# ⚠️ 切勿在此处粘贴真实密钥（.env 才填真实值；.env 已被 .gitignore 排除）。
# 说明：下方这套 KIMI 服务会在首次初始化时被「设置中心 · AI 模型服务」作为内置默认服务自动种入，
#       之后可在 UI 中改 / 增 / 删服务并切换默认（库内非空即不再被 env 覆盖）。
AGENT_PROVIDER=anthropic
AGENT_BASE_URL=https://api.kimi.com/coding
AGENT_API_KEY=
# 任务显式指定 kimi-k2.6；docs/examples 已实测可用的回退值为 kimi-k2.5（model-not-found 时一行切回）。
AGENT_MODEL=kimi-k2.6
# KIMI Coding 端点校验 User-Agent，默认 claude-code/1.0（一般无需修改）。
AGENT_USER_AGENT=claude-code/1.0
# Agent LLM 独立代理：留空回落系统/OKX 代理；显式 none 强制直连。
# AGENT_PROXY=
# ---- 加固增强（iteration 2）：LLM 传输层有界重试 + 断连 drain 超时（一般无需修改）----
# pre-stream 重试上限（429/5xx/网络瞬断退避重试；最多 1+N 次尝试，0 即不重试）。
AGENT_MAX_RETRIES=2
# 指数退避基数（毫秒，第 i 次退避 base*2**i，封顶 max）。
AGENT_RETRY_BASE_MS=500
# 单次退避封顶（毫秒，亦为 Retry-After 整数秒解析上限）。
AGENT_RETRY_MAX_MS=8000
# 断连后等待 in-flight run 收束的兜底超时（秒）；超时即 cancel 孤儿，清理永不挂死。
AGENT_DRAIN_TIMEOUT_SECONDS=8.0
# ---- 韧性流式（iteration 3）：run/socket 解耦续流 + 心跳保活（一般无需修改）----
# 断连后 in-flight 回答的存活宽限（秒）：宽限内重连即续流，宽限耗尽才取消并落盘。
# 设为 0 即"断连立即取消"（回退迭代 2 行为，一键安全阀）。
AGENT_DETACH_GRACE_SECONDS=30.0
# run 期心跳间隔（秒）：保活长回测期间的 WS，须 < 中间层 idle 超时。
AGENT_HEARTBEAT_SECONDS=20.0
# 会话事件缓冲上限（条）：重连重放窗口；越大可覆盖越长的断连，内存占用越高（下限 64）。
AGENT_EVENT_BUFFER_SIZE=512
