# ============================================================================
# Aragon Trading — 环境变量示例 (.env.example)
# 复制为 services/quant/.env (后端) 与 apps/web/.env.local (前端) 后填值。
# 安全提示 (spec §12 C7): 切勿把真实 API 密钥提交进仓库。.env 已被 .gitignore 排除。
# 本期 (Phase 1) 仅使用 OKX 公共行情，OKX_* 凭据可全部留空。
# ============================================================================

# ---- 前端 (apps/web) ----
# 端口刻意选用不常用值（后端 18760 / 前端 18761），避开 3000/8000 等常见占用。
# Next.js 反向代理目标：把 /api/py/* 转发到 Python 后端
PY_BACKEND_URL=http://localhost:18760
# 浏览器直连 Python WebSocket 的基址
NEXT_PUBLIC_PY_WS_URL=ws://localhost:18760

# ---- 后端 (services/quant) ----
# OKX 私有接口凭据 —— 本期不使用，留空即可。
# ⚠️ 切勿粘贴真实密钥；若曾在别处明文出现，请视为已泄露并轮换 (spec R3)。
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# 访问 OKX 的代理（本机检测到 Clash: 127.0.0.1:7897）。httpx/websockets 透传。
HTTP_PROXY=http://127.0.0.1:7897
HTTPS_PROXY=http://127.0.0.1:7897
# ALL_PROXY=socks5://127.0.0.1:7897

# OKX 端点（一般无需修改）
OKX_REST_BASE=https://www.okx.com
# OKX V5 公共行情分两个 WS 端点：trades/tickers/books5（盘口/成交/ticker）走 public，
# candle{bar} K 线走 business（互相订阅会回 60018 "channel doesn't exist"）。两者都要配。
OKX_WS_PUBLIC=wss://ws.okx.com:8443/ws/v5/public
OKX_WS_BUSINESS=wss://ws.okx.com:8443/ws/v5/business

# SQLite 数据文件路径（相对 services/quant 运行目录）
DB_PATH=aragon.db

# 默认标的 / 周期 / 初始资金
DEFAULT_INST=BTC-USDT-SWAP
DEFAULT_BAR=1H
INITIAL_CAPITAL=10000

# 仅开发用：是否允许在 OKX 不可达时回退到本地缓存样例（默认 false，生产/验收必须 false）
ALLOW_CACHED_FALLBACK=false

# 同时活跃的实时模拟会话上限
MAX_PAPER_SESSIONS=3

# ---- 实盘交易（LIVE_*，真实资金，spec §3）----
# 实盘下单总开关：默认已开启（true），下单 / 设杠杆写接口可用。
# ⚠️ 安全阀：设为 false 即一键回退「real trading disabled」安全姿态，写接口一律 403、仅可查看真实持仓 / 成交。
LIVE_TRADING_ENABLED=true
AI_TRADE_ENABLED=true
# 单笔下单名义价值本地上限（USDT），越界本地拦截；需放大须在此显式覆写。
LIVE_MAX_ORDER_NOTIONAL_USD=1000
# 合约默认保证金模式（cross | isolated）。
LIVE_DEFAULT_TD_MODE=cross
# 下单面板默认杠杆。
LIVE_DEFAULT_LEVERAGE=3

# ---- AI 自动交易 · 限价委托挂单（AI_TRADE_LIMIT_*，spec ai-trade-limit-orders §5.3）----
# 限价总闸：开启后 Agent 可在决策里给 orderType=limit + limitPrice 挂单，并用 cancel_order 撤回自己
# 未成交的挂单；仍可照旧市价委托。设为 false 即逐字回退到 market-only（Agent 看不到这些字段）。
AI_TRADE_LIMIT_ORDERS_ENABLED=true
# 本地价带门禁：|limitPx-lastPx|/lastPx 超此值即降级 hold 并要求 Agent 重新研判。
# 比 OKX 侧 ±5% 限价带更紧、先触发、不消耗 API 配额，用于挡住 LLM 的幻觉价。
AI_TRADE_LIMIT_PRICE_MAX_DEVIATION_PCT=0.02
# 挂单存活上限（秒）：到期自动撤销，避免永不成交的挂单长期占用保证金与会话预算。
AI_TRADE_LIMIT_ORDER_TTL_S=300

# ---- AI 自动交易 · 【基础策略】铁律层（AI_TRADE_BASE_RULE*，spec ai-trade-base-strategy-ma-band §5.3）----
# 基础策略总闸：无论用户选了哪些常规/组合/因子策略，开仓只允许发生在执行周期 MA 通道的上轨/中轨/下轨
# 附近（限价委托按**委托价**判定）。设为 false 即逐字回退到本特性合入前（不注入 prompt、不调门禁）。
AI_TRADE_BASE_RULES_ENABLED=true
# 中轨 SMA 周期与上下轨标准差倍数（通道 = MA(period) ± std_mult × σ）。
AI_TRADE_BASE_RULE_MA_PERIOD=20
AI_TRADE_BASE_RULE_MA_STD_MULT=2.0
# 「附近」的容差（带宽归一的 %B 距离，跨周期同义）：0.05 极严 / 0.15 标准 / 0.25 = 仅限带内（最宽松）。
AI_TRADE_BASE_RULE_BAND_TOLERANCE=0.15
# 方向性模式（做多只许下轨/中轨、做空只许上轨/中轨）：默认关，趋势突破类策略慎开。
AI_TRADE_BASE_RULE_DIRECTIONAL=false

# ---- AI 自动交易 · 成本记账与最小 edge 门禁（spec ai-trade-cost-accounting-and-edge-gate §5.1）----
# 本段只作用于 **AI 会话**：非 AI 的 live_auto 恒不注入费率账本，这些开关取任何值都不影响它。
# A0-1 记录层：每笔成交按确定性费率模型入账（notional × feeBps），实测费率只进归因、绝不回写盈亏。
AI_TRADE_FEE_ACCOUNTING_ENABLED=true
# A0-2 口径切换：平仓盈亏扣双边费用 ⇒ 会话盈亏变净额。**破坏性变更，默认关**；开启前请先确认
# 费率入账完整性达 100%（滚动 50 笔），并知悉历史数据与新口径不可比。
AI_TRADE_NET_PNL_ENABLED=false
# 腿费率（bps）：限价挂单成交按 maker、市价 / OCO / 外部平仓按 taker。刻意不复用回测世界的
# DEFAULT_TAKER_FEE_BPS —— 两个世界的成本假设必须能各自演进。
AI_TRADE_MAKER_FEE_BPS=2.0
AI_TRADE_TAKER_FEE_BPS=5.0
# 无盘口数据时的半价差保守假设与冲击成本常数（bps）。
AI_TRADE_HALF_SPREAD_FALLBACK_BPS=1.0
AI_TRADE_IMPACT_BPS=0.5
# 成本模型的预期持仓根数（资金费率结算周期数由它推）。装配了交易周期模式的会话会用该模式派生的
# 目标持仓根数**覆盖**本值（见下方 AI_TRADE_HORIZON_*）；未装配时逐字沿用本常数。
AI_TRADE_COST_EXPECTED_HOLD_BARS=8
# 最小 edge 门禁：毛 edge(bps) ≥ K_MIN × 往返成本(bps) 才允许开仓。**0 = 门禁空转（默认）**；
# 上线 runbook：先满 50 笔费率入账 → 开 A0-2 → 观察 100 笔 → 再置 2.0。
AI_TRADE_EDGE_GATE_K_MIN=0.0
# 成本估算降级（资金费率缺席）时的阈值收紧倍数。
AI_TRADE_EDGE_GATE_DEGRADED_MULT=1.2
# 粗估毛 edge 的 ATR 倍数（阶段一的 edge 分子是显式标注的粗估，非概率化先验）。
AI_TRADE_EDGE_ATR_TARGET_MULT=1.0
# 永续资金费率取数：关闭 ⇒ 资金费率项恒 0 且置信度保持 ok（有意选择 ≠ 数据缺失）。
AI_TRADE_FUNDING_ENABLED=true
AI_TRADE_FUNDING_POLL_TTL_S=60
# 实测成交明细旁路审计（校准模型费率 / 观测滑点）：只跑在 5s 盯市上，绝不进决策轮。
AI_TRADE_FILL_AUDIT_ENABLED=true
AI_TRADE_FILL_AUDIT_INTERVAL_S=60

# ---- AI 自动交易 · 交易周期模式 / 持仓周期铁律层（AI_TRADE_HORIZON_*，spec ai-trade-holding-horizon-modes §5.1）----
# 用户在启动弹窗选一种「交易周期模式」，系统据此对**AI 主动发起的**平仓与反手施加三条确定性约束
# （最短主动平仓窗口 / 离场连续确认 / 换手迟滞）。**止损、交易所 OCO、利润保护层、会话止盈止损、
# 强制时间平仓一律不受影响**——本层极性为 fail-open，任何算不出的断面一律放行。
# 总闸置 false ⇒ 恒不装配、prompt 不注入、门禁直通 ⇒ 逐字回退到本特性合入前。
AI_TRADE_HORIZON_ENABLED=true
# 请求体缺省时装配的模式：hourly_swing | intraday_swing | short_swing | trend_hold | custom。
AI_TRADE_HORIZON_DEFAULT_PROFILE=intraday_swing
# 回测侧运维总闸（false ⇒ 回测恒不装配，一键回到无本层的回测行为）。
AI_TRADE_HORIZON_BACKTEST_ENABLED=true
# 是否把「反手」也纳入约束（false ⇒ 反手恒直通，本层只拦 close）。
AI_TRADE_HORIZON_GATE_REVERSE=true
# 豁免阈：有单仓 OCO 止损时 `解除阈 = 止损% × 杠杆 × FRAC`（保证金收益率口径）；无止损时取兜底常数。
# 浮亏达到该阈值 ⇒ 三道闸**全部解除**，Agent 重新拥有随时止损的自由。
AI_TRADE_HORIZON_LOSS_RELEASE_FRAC=0.5
AI_TRADE_HORIZON_LOSS_RELEASE_RETURN_PCT=0.10
# 连续被本层拦截 N 轮后，在每轮 prompt 里注入一段自察注记（0 = 关闭 ⇒ prompt 逐字节回退）。
AI_TRADE_HORIZON_NOTE_AFTER_ROUNDS=3

# ---- AI 自动交易 · 开仓侧换手纪律（AI_TRADE_HORIZON_TURNOVER_* / _REENTRY_*，
#      spec ai-trade-turnover-budget-and-backstop §5.1）----
# 上面三道闸只约束「平」，留下一条完整的**合法绕行路径**：开仓 → 持够最短窗口 → 平仓 → 下一轮
# 立刻同向重开。这条路径上每一步都合法，而它产生的换手率恰好是同一份契约给自己定的验收门槛的
# 两倍。本段补上「不许过快重开」的另一半。
# 两条铁律：**绝不阻止任何一次退出**（平仓 / 观望 / 撤单 / 同向加仓永不被拦；被拦的反手降级为
# 平仓，退出腿照常执行）；**fail-open**（算不出一律放行——拦的是「再开一单」，fail-closed 的
# 代价是一台永不交易的机器）。总闸置 false ⇒ 整层不装配、prompt 与 status 逐字节回退。
AI_TRADE_HORIZON_TURNOVER_ENABLED=true
# 回测侧独立总闸（false ⇒ 回测恒不装配这两道闸）。
AI_TRADE_HORIZON_TURNOVER_BACKTEST_ENABLED=true
# G4 再入场冷却 = FRAC × 最短主动平仓窗口（即目标持仓下界的 1/4）。0 ⇒ **关闭本闸**（不是无限长）。
AI_TRADE_HORIZON_REENTRY_FRAC=0.5
# 冷却作用域：same_side 只拦被平掉的那一侧（默认，反向开仓是结构翻转的合法表达）| both 两侧都拦。
AI_TRADE_HORIZON_REENTRY_SCOPE=same_side
# G5 换手预算（令牌桶）。**速率刻意没有配置项**：它恒等于验收卡第 3 行的阈值
# `min(86400/目标持仓下界, 24)`——另开一个旋钮就等于允许「弹窗承诺 6 次、运行期执行 12 次」。
# 注意口径：令牌桶是**会话内存态、启动即满桶**，停会话重开即回满；三处文案一律自认为「本会话」。
# 一旦本闸武装，验收卡第 3 行就从「独立观测」退化为「执行结果」、接近恒真——该行的 note 会自动
# 追加一句自认，请以第 1、4、5 行为准。
AI_TRADE_HORIZON_TURNOVER_BURST_FRAC=0.5
# 容量下限是刻意的安全阀，不是凑整：趋势持仓速率是 1 次/日，容量若也取 1，一次早期止损后会话要
# 整整 22 小时开不出下一单。容量只影响突发、不影响长期速率。
AI_TRADE_HORIZON_TURNOVER_MIN_CAPACITY=2.0

# ---- AI 自动交易 · 交易所侧兜底真值化（AI_TRADE_BACKSTOP_*，同 spec §2.3）----
# 「交易所侧兜底：止盈 X / 止损 Y（进程退出后仍生效）」此前是一句**从未核实过**的话：它的真源是
# 本地下单回执，系统从不查交易所。而这句承诺恰是跨日模式「不必每轮盯盘」的唯一前提。本段加一条
# 低频、单飞、**只读**的私有 GET（orders-algo-pending），把它变成带三态 basis 的事实：
#   exchange = 核实过 | local = 未核实 | unavailable = 尝试过但失败。核实不到就如实说未核实。
# 总闸置 false ⇒ 一个请求都不发、兜底文案逐字回退到本地回执口径（并如实说明「尚无核实通道」）。
# **本轮明确不做自动补挂 / 重挂**：那需要一条全新的下单写路径，与本仓库全部 AI 侧安全层「绝不新增
# 下单路径」的纪律冲突；先把「知道有没有」做扎实——没有可信的检测，任何自动补挂都是盲目下单。
AI_TRADE_BACKSTOP_CHECK_ENABLED=true
# 核实节流（秒）：仅持仓时查；新开仓后下一个盯市 tick 立即核实一次（随单 OCO 是否真的挂上，
# 是开仓后最值得立刻知道的一件事）。
AI_TRADE_BACKSTOP_POLL_TTL_S=120
AI_TRADE_BACKSTOP_TIMEOUT_S=6
# 核实结果的最大可信年龄（秒）：超过即从 exchange 降级为 unavailable(stale)，绝不拿旧读数背书。
AI_TRADE_BACKSTOP_MAX_AGE_S=300
# G6 覆盖闸阈值：交易所侧止损覆盖率低于该比例时拦下**继续加仓**。
# 三条 fail-open：未核实不拦、**覆盖率算不出（交易所未回报可核对张数）不拦**、空仓开仓与反手不拦
# ——「算不出」绝不能变成「不许加」，把「不知道」渲染成确定的坏消息比原来那句没核实的话更坏。
AI_TRADE_BACKSTOP_MIN_COVERAGE=0.999
# G6 单独开关（false ⇒ 只报不拦：文案与 UI 照常如实呈现覆盖率，但不拦任何加仓）。
AI_TRADE_BACKSTOP_GATE_SCALE_IN=true

# ---- AI 自动交易 · 交易所侧兜底自愈（AI_TRADE_BACKSTOP_REPAIR_*，
#      spec ai-trade-backstop-repair-and-net-backtest §2.2）----
# 上一轮把「交易所侧到底挂着什么」做成了可核实的事实，但检测到「没有兜底」之后系统什么都不做：
# 一个 trend_hold 会话（目标持仓 1–3 天、唤醒周期 0）会带着一个裸露的仓位继续跑 1–3 天。本段补上
# 执行体：一条**只补止损腿、只补差额张数、只减不增**的写路径（POST /trade/order-algo）。
# 总闸置 false ⇒ 整层不装配、horizon.backstop.repair 整键缺席、prompt 逐字回退、人工端点 404、
# 一个写请求都不发。
AI_TRADE_BACKSTOP_REPAIR_ENABLED=true
# 缺省模式：plan = 只给方案 + 一键人工执行；arm = 核实到缺失即自动补挂。
# **默认 plan** 是刻意的：这是本仓库第一条 AI 侧自动写路径，默认给方案而不是默认自动花钱。
AI_TRADE_BACKSTOP_REPAIR_DEFAULT_MODE=plan
# 触发价与现价之间要求的最小距离（bps）：补一张会立刻触发的止损 = 立刻市价平仓，那不是兜底，
# 那是替模型在最坏价位上做了一个它没做的退出决策。
AI_TRADE_BACKSTOP_REPAIR_MIN_GAP_BPS=15
# 频率锁：单持仓周期 / 单会话的补挂次数上限，以及两次尝试之间的最小间隔（失败也计入）。
# **MAX_PER_EPOCH=0 表示整层关闭**（自动与人工都不补），不是「无限次」。
AI_TRADE_BACKSTOP_REPAIR_MAX_PER_EPOCH=2
AI_TRADE_BACKSTOP_REPAIR_COOLDOWN_S=60
AI_TRADE_BACKSTOP_REPAIR_MAX_PER_SESSION=8
# 覆盖率阈值与判定价年龄阈**不新开旋钮**：分别复用 AI_TRADE_BACKSTOP_MIN_COVERAGE 与
# AI_TRADE_PROFIT_GUARD_MAX_PX_AGE_S——同一个会话里「多少算覆盖不足」「判定价多老算老」
# 只能有一个答案。

# ---- AI 自动交易 · 回测净额真值（AI_TRADE_FUNDING_COST_BACKTEST_ENABLED，同 spec §2.3）----
# 回测的**记账**自上一轮起已含真实资金费，但**成本估算**的两个入口仍硬传 funding_enabled=false，
# 于是 G3 换手迟滞与最小 edge 门禁在回测里按「资金费为 0」判定、实盘按真实资金费判定：回测系统性
# 比实盘乐观，而且模式越长越乐观（trend_hold 跨 9 个结算点约 9 bps，与一整趟双边 taker 费同量级）。
# 置 false ⇒ 两处入参逐字节回退，回测结果与本轮之前完全相同。
AI_TRADE_FUNDING_COST_BACKTEST_ENABLED=true

# ---- AI 自动交易 · 持仓周期验收闭环（AI_TRADE_FUNDING_* / AI_TRADE_EXIT_* / AI_TRADE_ACCEPTANCE_*，
#      spec ai-trade-horizon-acceptance-loop §5.1）----
# 上一轮把「让持仓活得够久」的机制建起来了；本段建的是「它到底有没有把钱赚回来」的判据：
# 真实资金费 / 退出来源分布 / 一张五行净额验收卡。三者都是**只加观测**，不改任何门禁行为。
# 轴 A 资金费账本总闸：false ⇒ 账本恒空转、aiStats.funding 整键缺席、验收卡第 5 行判「样本不足」。
AI_TRADE_FUNDING_LEDGER_ENABLED=true
# 结算周期合理性区间（秒）：交易所读数落在区间外即视为坏读数 ⇒ 本次**不计提**。
# OKX 的结算周期会动态变为 1/2/4/8 小时，故绝不固定假设 8h（调查约束 #7）。
# **有意的不对称**：同一个「结算周期未知」，记账层不计提、成本层（AI_TRADE_COST_*）继续按 8h 保守
# 估算——成本估算宁可高估（门禁更严），记账宁可不记（绝不把猜的数当真值上报）。
AI_TRADE_FUNDING_MIN_INTERVAL_S=1800
AI_TRADE_FUNDING_MAX_INTERVAL_S=28800
# 回测侧历史费率曲线总闸（false ⇒ 回测资金费恒「口径不可得」，绝不按 0 呈现）。
AI_TRADE_FUNDING_BACKTEST_ENABLED=true
# 历史费率曲线的最大翻页数（1 页 = 100 个结算点；8 页 ⇒ 8h 周期下约 266 天）。
AI_TRADE_FUNDING_HISTORY_MAX_PAGES=8
# 轴 B 退出来源归因总闸：false ⇒ explain.meta.exitSource 整键缺席（老数据同样缺席，查询侧按未记录）。
AI_TRADE_EXIT_ATTRIBUTION_ENABLED=true
# 轴 C 周期验收卡总闸与三个阈值。样本不足一律判 insufficient（灰色）而**永远不是** pass——
# 「未通过样本外净额回测前不得放大实盘资金」这条纪律唯一的技术保证。
AI_TRADE_ACCEPTANCE_ENABLED=true
AI_TRADE_ACCEPTANCE_MIN_ROUND_TRIPS=20
AI_TRADE_ACCEPTANCE_MIN_WITHIN_TARGET_RATE=0.6
AI_TRADE_ACCEPTANCE_MAX_FEE_TO_GROSS=0.35

# ---- AI 自动交易 · 信号先验体系与 EV 分子（AI_TRADE_PRIOR_* / 三总闸，spec ai-trade-signal-prior-and-ev-gate §七）----
# 三个默认关闭的独立总闸：全关时逐字节回退到阶段一行为。上线顺序 L1 → L2 → L3（见 spec §九 runbook）。
AI_TRADE_SIGNAL_PRIOR_ENABLED=false
AI_TRADE_WEIGHTED_CONSENSUS_ENABLED=false
# 总闸③开启前必须先把 AI_TRADE_EDGE_GATE_K_MIN 推上去（k_min=0 时门禁整体空转，开③什么都不会发生）。
AI_TRADE_EDGE_PRIOR_ENABLED=false
# 单条先验的可用性判据：事件数 / 独立事件段数（仅策略侧）/ 有效段数下限。
AI_TRADE_PRIOR_MIN_SAMPLES=30
AI_TRADE_PRIOR_MIN_RUNS=10
AI_TRADE_PRIOR_MIN_SEGMENTS=6
# 段级时间衰减半衰期（天）与段末隔离根数（0=关闭跨段隔离）。
AI_TRADE_PRIOR_DECAY_HALF_LIFE_DAYS=30
AI_TRADE_PRIOR_EMBARGO_BARS=12
# IR 权重上限（0 ⇒ 先验恒缺席，等价关闭）与 prompt 证据明细条数上限。
AI_TRADE_PRIOR_IR_CLIP=2.0
AI_TRADE_PRIOR_TOP_N=5
# 快照陈旧度门禁（秒，默认 7 天）：每 7 天须重建一次；改持有期或策略参数后必须立即重建。
AI_TRADE_PRIOR_MAX_AGE_S=604800
# rebuild 的缺省回看根数与取数前硬上限（越界即 413 AI_PRIOR_TOO_LARGE，绝不无界拉 K 线）。
AI_TRADE_PRIOR_LOOKBACK_BARS=4000
AI_TRADE_PRIOR_MAX_BARS=8000

# ---- AI 自动交易 · 唤醒感知上下文（AI_TRADE_TACTICAL_* / AI_TRADE_WAKE_*，spec ai-trade-wake-aware-context §4.2）----
# 轴 A：战术周期证据。定时唤醒轮过去拿到的行情证据与上一轮**逐字节相同**（信号板只在确认根重算），
# 模型被迫对同一份证据反复表态、只能反复 hold。补上「严格短于执行周期、贴唤醒节奏」的第三层时间尺度：
# 30m 执行 + 3 分钟唤醒 ⇒ 注入 1m/5m 的体制、指标与「自上轮收了几根」。false ⇒ 整键缺席 + prompt 逐字回退。
AI_TRADE_TACTICAL_CONTEXT=true
# 注入的战术周期数（0 等价关闭）；每周期窗口根数（默认 120；调低到 60 以下时 classify_regime 会
# 判不出体制，战术帧只剩证据摘要——这是可接受的降级，但别指望还能看到「体制背离」提示）。
AI_TRADE_TACTICAL_MAX_BARS=2
AI_TRADE_TACTICAL_WINDOW_BARS=120
# REST 刷新硬下限（秒，配额护栏防 429）与单次取数硬超时（秒）。后者护的是 5 秒盯市循环——同一个 tick
# 还守着利润保护棘轮与会话止损这些**真实资金**路径，交易所慢响应绝不能把它们挤停。
AI_TRADE_TACTICAL_MIN_REFRESH_S=20
AI_TRADE_TACTICAL_FETCH_TIMEOUT_S=8
# 战术段渲染字符上限（0=不截断）；超限会追加**可见**截断标记，绝不静默截断。
AI_TRADE_TACTICAL_MAX_CHARS=700
# 轴 B：唤醒原因。trigger 的二值扩成七种结构化 kind（新 K 线收盘 / 补看新 K 线 / 挂单盯守 / 浮盈跨档 /
# 价格异动 / 持仓盯市 / 心跳），同时驱动跳过守卫与 prompt 措辞，并落进 trades.explain_json.meta.wakeKind
# 供事后按唤醒来源切胜率。false ⇒ payload/prompt/事件/归因整体回退到二值 trigger。
AI_TRADE_WAKE_REASON_ENABLED=true
# 价格异动判据（×执行周期 ATR，经 √t 律折算到唤醒窗口的时间尺度）；0 ⇒ 逐字回退纯 pct 判据
# （AI_TRADE_WAKE_SKIP_UNCHANGED_PCT）。折算系数刻意不做成配置项：它是量纲折算而非调参旋钮。
AI_TRADE_WAKE_MOVE_ATR_MULT=0.5
# 连续跳过上限，到即强制放行一轮（饿死兜底）；0 = 不封顶。没有这条上界，静止行情下 AI 会变成事实
# 上的停机，而用户看不到任何原因。
AI_TRADE_WAKE_MAX_SKIP_STREAK=5
# 渐进式上下文披露：同一根执行 K 线的第 2 次及以后决策，把中线背景与执行周期证据压成压缩形态
# （最新变化改由战术周期承载）。false ⇒ 恒全量披露。
AI_TRADE_PROGRESSIVE_DISCLOSURE=true

# ---- AI 自动交易 · 唤醒调度闭环（AI_TRADE_WAKE_* / AI_TRADE_SIGNAL_WAKE_*，spec ai-trade-wake-scheduler-closed-loop §4.2）----
# 上一段解决的是「唤醒之后喂什么」，本段解决「何时唤醒、唤醒丢了怎么办、唤醒值不值」。
# 轴 A：唤醒补跑。上一轮 LLM 还在飞时到达的唤醒过去是**静默消失**（最坏一轮 ≈379 秒，1m/5m 周期下
# 能吞掉 6 根确认根，「恰好错过关键那根 K 线」由此而来）。改成记一笔待办，轮末用同一个分类器重判，
# 输入确实变了就立刻补跑一轮，并把「丢了几次、其中几根 K 线收线没被研判」如实写进 prompt。
# false ⇒ 只计数不补跑（观测保留，行为逐字回退）。
AI_TRADE_WAKE_BACKLOG_ENABLED=true
# 连续补跑上限（触顶即弃单并计一次 ceilingHits）。刻意**没有**「0=不封顶」：无上限的补跑链等于
# 无上限的 LLM 花费；「不补跑」由上一行的总闸表达。
AI_TRADE_WAKE_BACKLOG_MAX_CHAIN=3
# 轴 B：持仓轮唤醒经济学。持仓期间的退出已被 5 秒确定性层接管（利润保护棘轮只收紧不放松、会话级
# 止盈止损、交易所侧 OCO），AI 被叫醒后绝大多数轮次只能输出 hold——烧钱且给「观望」堆假证据。
# 允许跳过 position_watch 轮，但**只在利润保护快照处于 armed/breakeven_armed 时**：idle/unavailable
# 下 AI 是唯一退出路径，一次都不跳。false ⇒ 逐字回退「持仓轮永不跳过」。
AI_TRADE_WAKE_SKIP_POSITION_WATCH=true
# 持仓连续跳过上限，到即强制放行一轮（比空仓的 5 更紧）。同样没有「0=不封顶」——持仓期无限期不研判
# 是一个能亏真钱的状态。
AI_TRADE_WAKE_POSITION_WATCH_MAX_SKIP_STREAK=3
# 轴 C：信号驱动唤醒（**首发默认关**）。在未确认根上深拷贝一份策略与影子 broker 做无副作用预演，
# 只有「投影净共识立场」翻转且连续保持 hold_s 秒与 min_samples 次**有效**观测（行情确实变过才算）
# 才唤醒一次。翻转证据以 provisional 身份进 payload——信号板与全部门禁一律仍以确认根为准，故最坏
# 后果只是多烧一次 token。本轴是唯一会占用守着真实资金的 5 秒盯市 tick 与线程池的一条，故默认关闭。
AI_TRADE_SIGNAL_WAKE_ENABLED=false
# 防抖双条件（缺一不可）：只看时长，一次 15 秒间隔的采样就能「保持 45 秒」；只看次数，高频 tick 会
# 让它瞬间达标。min_samples 下限为 2——`hold_s=0 + min_samples=1` 是零防抖。
AI_TRADE_SIGNAL_WAKE_HOLD_S=45
AI_TRADE_SIGNAL_WAKE_MIN_SAMPLES=3
# 两次信号唤醒的最小间隔（LLM 花费上界）。
AI_TRADE_SIGNAL_WAKE_MIN_GAP_S=120
# 预演节流（≈每 3 个盯市 tick 一次）与单次预演硬超时。超时即退避（间隔翻倍，上限 300s）。
# 首次到期按 session_id 稳定哈希错峰，避免分组 N 个成员同时向线程池投 CPU 密集预演。
AI_TRADE_SIGNAL_WAKE_PREVIEW_INTERVAL_S=15
AI_TRADE_SIGNAL_WAKE_TIMEOUT_S=3
# 判定价新鲜度闸：距上次收到任意价格推送超过该秒数即不预演。没有它，一个静默的 WS 就能让
# 「该翻转已连续保持 45 秒」这句话在零新数据的情况下成立。
AI_TRADE_SIGNAL_WAKE_STALE_S=90

# ---- 波动率目标化仓位 + ATR 止损 + 相关性预算 + 回撤刹车（vol-sizing-and-drawdown-brake §4.4）----
# 四个相互独立、**默认全关**的总闸：全关时逐字节回退到阶段二第一步（commit c6db95d）的行为。
# 总闸①：波动率目标化仓位求解（f 由已实现波动率、胜率先验、edge 与成本共同解出，模型的
# sizeFraction 降级为「上限提议」，只会被调小、不会被调大）。
AI_TRADE_SIZING_ENABLED=false
AI_TRADE_VOL_TARGET_ANNUAL=0.20
# 已实现波动率回看根数（15m ⇒ 一整天）。注意：它 + 1 必须 <= 行情窗口容量，否则启动即 422
# AI_TRADE_SIZING_WINDOW_TOO_SMALL（窗口最小可到 80，默认 96 需要把 primingBars 调到 >= 97）。
AI_TRADE_REALIZED_VOL_WINDOW=96
# 凯利缩放（四分之一凯利）；0 = 凯利项整体不参与 min。赔率的 W/L 恒取本轮实际要挂的那对括号。
AI_TRADE_KELLY_LAMBDA=0.25
# 总闸②：ATR 止损倍数（**与总闸①独立**，runbook L1 只开这一个）；0 = 逐字回退固定百分比止损。
AI_TRADE_STOP_ATR_MULT=0.0
AI_TRADE_STOP_RR=2.0
# 总闸③：组合有效敞口上限（平均单标的满仓名义额的倍数），取值域 {0} 并 [1,10]，越界即启动 422。
AI_TRADE_EFFECTIVE_EXPOSURE_CAP_MULT=0.0
AI_TRADE_CORRELATION_MIN_SAMPLES=96
# 总闸④：三级刹车。**阈值必须按杠杆定标**——session_pnl 落在已含杠杆的名义额上，而回撤的分母是
# 保证金口径的预算，故 3x 杠杆下 8%/15% 等价于标的价反向 2.7%/5.0%。以 3x 为锚点按 x 3/leverage
# 折算：3x => 0.08 / 0.15；5x => 0.048 / 0.09。三档默认全关，合并即全关、逐级打开。
AI_TRADE_BRAKE_SLOW_DD_PCT=0.0
AI_TRADE_BRAKE_SLOW_SIZE_MULT=0.5
AI_TRADE_BRAKE_HALT_DD_PCT=0.0
AI_TRADE_BRAKE_LOSS_STREAK=0
AI_TRADE_BRAKE_LOSS_COOLDOWN_BARS=4.0

# ---- Agent（对话式 AI 助手）LLM 接入 ----
# AI 助手的模型接入，支持 anthropic / openai 两种标准；密钥仅存后端，绝不下发前端。
# ⚠️ 切勿在此处粘贴真实密钥（.env 才填真实值；.env 已被 .gitignore 排除）。
# 说明：下方这套 KIMI 服务会在首次初始化时被「设置中心 · AI 模型服务」作为内置默认服务自动种入，
#       之后可在 UI 中改 / 增 / 删服务并切换默认（库内非空即不再被 env 覆盖）。
AGENT_PROVIDER=anthropic
AGENT_BASE_URL=https://api.kimi.com/coding
AGENT_API_KEY=
# 任务显式指定 kimi-k2.6；docs/examples 已实测可用的回退值为 kimi-k2.5（model-not-found 时一行切回）。
AGENT_MODEL=kimi-k2.6
# KIMI Coding 端点校验 User-Agent，默认 claude-code/1.0（一般无需修改）。
AGENT_USER_AGENT=claude-code/1.0
# Agent LLM 独立代理：留空回落系统/OKX 代理；显式 none 强制直连。
# AGENT_PROXY=
# ---- 加固增强（iteration 2）：LLM 传输层有界重试 + 断连 drain 超时（一般无需修改）----
# pre-stream 重试上限（429/5xx/网络瞬断退避重试；最多 1+N 次尝试，0 即不重试）。
AGENT_MAX_RETRIES=2
# 指数退避基数（毫秒，第 i 次退避 base*2**i，封顶 max）。
AGENT_RETRY_BASE_MS=500
# 单次退避封顶（毫秒，亦为 Retry-After 整数秒解析上限）。
AGENT_RETRY_MAX_MS=8000
# 断连后等待 in-flight run 收束的兜底超时（秒）；超时即 cancel 孤儿，清理永不挂死。
AGENT_DRAIN_TIMEOUT_SECONDS=8.0
# ---- 韧性流式（iteration 3）：run/socket 解耦续流 + 心跳保活（一般无需修改）----
# 断连后 in-flight 回答的存活宽限（秒）：宽限内重连即续流，宽限耗尽才取消并落盘。
# 设为 0 即"断连立即取消"（回退迭代 2 行为，一键安全阀）。
AGENT_DETACH_GRACE_SECONDS=30.0
# run 期心跳间隔（秒）：保活长回测期间的 WS，须 < 中间层 idle 超时。
AGENT_HEARTBEAT_SECONDS=20.0
# 会话事件缓冲上限（条）：重连重放窗口；越大可覆盖越长的断连，内存占用越高（下限 64）。
AGENT_EVENT_BUFFER_SIZE=512

# ============================ 策略与因子挖掘（strategy-factor-discovery §六） ============================
# ⚠️ 三处联动缺一即静默失效：① services/quant/app/config.py 必须真的声明字段
#    （Settings extra="ignore" 会吞掉未声明的 env）；② desktop/src/lib/config.js 的 prod 白名单
#    必须放行 DISCOVERY_ 前缀；③ 本文件补文档。
# 总闸：false ⇒ 写类端点 403（读类仍可看历史），且**自动续跑一票否决**（重启后一律 paused）。
DISCOVERY_ENABLED=true
# 并发挖掘任务上限（硬上限 3）。启动第 N+1 个任务返回 409 DISCOVERY_BUSY。
DISCOVERY_MAX_RUNS=1
# 迭代间隔默认与夹紧区间（秒）。默认 300 对齐参考报告的「每 5 分钟一轮」。
DISCOVERY_DEFAULT_INTERVAL_S=300.0
DISCOVERY_MIN_INTERVAL_S=60.0
DISCOVERY_MAX_INTERVAL_S=3600.0
# 单轮候选上限与数据窗口根数上限（取数工作量护栏）。
DISCOVERY_MAX_CANDIDATES_PER_ITER=200
DISCOVERY_MAX_WINDOW_BARS=8000
# 单轮工作量上限（候选数 × 根数），超限即启动前 413 DISCOVERY_TOO_LARGE。
DISCOVERY_WORK_UNIT_LIMIT=3000000
# 单候选验证墙钟超时 / 单轮墙钟预算（秒）。到点停取新候选、正常提交已完成者并如实上报丢弃数。
DISCOVERY_CANDIDATE_TIMEOUT_S=20.0
DISCOVERY_ITERATION_TIMEOUT_S=600.0
# 验证层进线程池的并发信号量（硬上限 8）。线程池与所有 API 请求共用，调大会让交互式请求变慢。
DISCOVERY_VALIDATE_CONCURRENCY=2
# LLM 子代理（生成 + 审查）：总闸 / 超时 / 重试 / 每小时调用硬上限。
# 关掉或未配置模型服务时，循环退化为**纯演化搜索**，入库标准不变（fail-open）。
DISCOVERY_LLM_ENABLED=true
DISCOVERY_LLM_TIMEOUT_S=60.0
DISCOVERY_LLM_MAX_RETRIES=1
DISCOVERY_LLM_MAX_CALLS_PER_HOUR=24
# 每 run 的保留上限（kept 候选永不剪；只剪 rejected 与迭代记录，剪枝量如实上报）。
DISCOVERY_MAX_CANDIDATE_ROWS=20000
DISCOVERY_MAX_ITERATION_ROWS=5000
# WS 环形缓冲条数（终态事件单独持槽，绝不被挤掉）。
DISCOVERY_WS_RING=400
# 进程重启后自动续跑 running 任务。受 DISCOVERY_ENABLED 一票否决；续跑必先重建候选池。
DISCOVERY_AUTO_RESUME=true
# 自动续跑前的静置延时（秒），等 OKX / DB 就绪。
DISCOVERY_RESUME_DELAY_S=10.0
# ---- 三条策略轴（discovery-strategy-axes §六）----
# 单轮**底层 run_backtest 调用次数**硬顶（不是候选数：一个策略轮动候选背后是 4–12 次）。
# 触顶即截断本轮剩余候选并记 truncatedByBacktestCap，绝不静默。
DISCOVERY_MAX_BACKTESTS_PER_ITERATION=120
# 单个策略候选的墙钟超时（秒）——样本内 / 样本外 / 成本压力**三段合计**。
DISCOVERY_BACKTEST_TIMEOUT_S=30.0
# 一个挖掘任务允许取的高周期帧数上限；超出的模板整体退出可挖目录并写明原因。
DISCOVERY_MAX_HTF_FRAMES=3
# 因子组合轴的成员目录上限（超出按「本任务 kept → 既有挖掘因子 → 库内内置」截断并留痕）。
DISCOVERY_MEMBER_CATALOG_MAX=60
# 低于此规模的轴本轮跳过 FSA 扫描：池里只有 3 条时每条都占 33% > 15%，会被全部冻结。
DISCOVERY_FSA_MIN_POOL=20

# ---- 成果资产台账与持续样本外体检（discovery-asset-ledger §六，共 15 个键）----
# ⚠️ 本组键**无需**改 desktop：desktop/src/lib/config.js 的 prod 白名单已放行整个
# `DISCOVERY_` 前缀（`key.startsWith('DISCOVERY_')`），DISCOVERY_HEALTH_* 天然被放行。
# 体检守护总闸。受 DISCOVERY_ENABLED 一票否决；两者任一为 false，守护每 tick 零副作用返回
# （不取数、不写库），运行期切换立刻生效。
DISCOVERY_HEALTH_ENABLED=true
# 守护轮询间隔（秒）与单个资产的体检周期（秒，默认 6h，与 dataRefreshS 同量级）。
DISCOVERY_HEALTH_TICK_S=900.0
DISCOVERY_HEALTH_INTERVAL_S=21600.0
# 单 tick 最多处理的资产数。
DISCOVERY_HEALTH_BATCH=8
# 单 tick 的**底层 run_backtest 调用次数**硬闸（不是资产数）：run_split_backtest 无条件跑
# 样本内 + 样本外两段，故预估口径是 2 × 每段次数。触顶即跳过并计入 summary.guard.skippedByCap。
DISCOVERY_HEALTH_MAX_BACKTESTS_PER_TICK=40
# 单个资产的体检墙钟超时（秒）。超时写一条 status=error 的记录（是资产自身的问题）。
DISCOVERY_HEALTH_ASSET_TIMEOUT_S=45.0
# 体检一次取多少根 K 线（暖机段 + 新增段），一个 (标的, 周期) 组一次取这么多。
DISCOVERY_HEALTH_WINDOW_BARS=1500
# 每个资产的暖机段根数。新增段起点由它反推：freshStart = max(挖掘窗口右端, 右端 −
# (WINDOW_BARS − WARMUP_BARS) × 周期)。⚠️ 必须 ≥ MIN_WARMUP_BARS 且 < WINDOW_BARS，
# 否则新增段恒空、所有资产永远「暂不评级」——启动时即 fail-fast 拒绝。
DISCOVERY_HEALTH_WARMUP_BARS=400
# 新增段 / 暖机段的最少根数：不足一律「暂不评级」，绝不给一个勉强的健康结论。
DISCOVERY_HEALTH_MIN_FRESH_BARS=120
DISCOVERY_HEALTH_MIN_WARMUP_BARS=300
# 策略类资产在新增段的最少成交笔数，不足即「暂不评级」。
DISCOVERY_HEALTH_MIN_FRESH_TRADES=5
# 留存门槛系数：新增段强度低于「登记时强度 × 该系数」即判衰减。
DISCOVERY_HEALTH_RETAIN_FRAC=0.5
# 迟滞：连续几次不达标才判「已衰减」（一次数据抖动不应把资产打成衰减）。
DISCOVERY_HEALTH_FAIL_STREAK=2
# 每个资产保留的体检记录条数上限，超出剪最旧并累加 checksPruned（绝不静默截断）。
DISCOVERY_HEALTH_MAX_CHECK_ROWS=200
# 台账规模护栏：触顶后停止登记**新**资产（仍继续合并溯源），只记录计数，不报错、不删旧。
DISCOVERY_HEALTH_MAX_ASSETS=5000

# ---- AI 自动交易 · 成本真值化与净额盈亏（ai-trade-cost-truth-and-net-pnl §5.5）----
# 净额口径总闸：**默认 true**（本轮翻转）。true ⇒ 平仓盈亏与持仓浮盈都扣掉双边手续费，
# 看板显示的就是「此刻平掉能拿到手的钱」。置 false 即逐字回到毛额口径（数字会整体偏高）。
AI_TRADE_NET_PNL_ENABLED=true
# 轴 A 官方费率真源：启动时按 instId 查 GET /account/trade-fee 取真实档位（签名私有 GET，读权限即可）。
# 关闭 ⇒ 一个请求都不发，费率恒取 AI_TRADE_MAKER_FEE_BPS / AI_TRADE_TAKER_FEE_BPS 常数。
AI_TRADE_FEE_RATE_SOURCE_ENABLED=true
AI_TRADE_FEE_RATE_TTL_S=3600
# 轴 D Agent 成本意识：把往返成本 / 盈亏平衡价 / 已付手续费写进系统 prompt 与每轮决策输入。
AI_TRADE_COST_AWARENESS_ENABLED=true
# 轴 C 交易所对账：用 GET /account/positions-history 的 realizedPnl 校验本地净额。**只观测、不回写盈亏**。
AI_TRADE_RECONCILE_ENABLED=true
AI_TRADE_RECONCILE_INTERVAL_S=300
AI_TRADE_RECONCILE_ABS_TOL_USD=0.5
AI_TRADE_RECONCILE_REL_TOL=0.05
AI_TRADE_RECONCILE_ALERT_STREAK=3
# stop 收尾强制对账的硬超时（秒）：观测层绝不延长真实资金平仓后的落库收尾。
AI_TRADE_RECONCILE_STOP_TIMEOUT_S=3
# 老 run（config_json 缺 costBasis）的口径推定：gross | net。
# **若你在本特性之前就已按 runbook 打开过 AI_TRADE_NET_PNL_ENABLED，必须置 net**，
# 否则那批已是净额的历史行会在统计看板上被二次扣费。
AI_TRADE_HISTORY_LEGACY_COST_BASIS=gross

# ---- AI 自动交易 · 生命周期真值化（ai-trade-lifecycle-truth §七）----
# 分组「在不在跑」从**被赋值的字段**改成**由会话事实派生的真值**，并随 wire 下发让人能反驳它的
# 证据（每个成员的会话态 / 行情年龄 / 链路是否连着 / 暖机根数 / 下一次唤醒还有多久）。
# false ⇒ 一键**逐字**回滚到本特性之前：不下发 lifecycle / declaredState / lifecycleUnknown /
# serverTs 四个加法键、group_status 的 state 回落为「上一次动作赋的值」、暂停期链路事件重新被
# SessionLink 丢弃、续跑不做武装复检。桌面打包经 desktop/src/lib/config.js 的 `AI_TRADE_` 前缀
# 白名单自动透传（那里是前缀规则，无需逐键登记）。
AI_TRADE_LIFECYCLE_TRUTH_ENABLED=true

# ---- OKX 链路韧性加固（okx-link-resilience §六）----
# 桌面打包经 desktop/src/lib/config.js 的 `OKX_` 前缀白名单透传；下列即默认值。
# 纪律：每个机制都有一个**关得掉的取值**（阈值 0 / 速率 0 / TTL 0），而不是新开一条代码分支。
# WS 三重活性判据（根因 A：半开连接今天永远不会重连，只表现为「K 线不动了」）。
OKX_LINK_WS_PING_INTERVAL_S=15.0
OKX_LINK_WS_PONG_TIMEOUT_S=8.0
OKX_LINK_WS_SILENCE_TIMEOUT_S=45.0
OKX_LINK_WS_SUBSCRIBE_TIMEOUT_S=10.0
# 通道级**数据静默**判据（ai-trade-feed-self-healing 轴 A）。与 SILENCE_TIMEOUT 的差别是**唯一**
# 的：那条读 last_inbound（任何入站帧，含 pong），这条只被业务数据帧刷新。「socket 活着、心跳
# 正常、candle 频道再也不推数据」在它出现之前**永远不会触发重连**，只表现为「K 线不动了」。
# 预算 = clamp(bar 秒数 x FACTOR, MIN, MAX)：bar >= 15m 恒取上界（candle 推的是未确认根，推送
# 密度只与成交密度相关、与周期无关），派生只在 1m~15m 起作用；public 端点无周期概念 ⇒ 取下界。
# FACTOR=0 ⇒ 整条判据关闭（逐字回退到本特性合入前）。
OKX_LINK_WS_DATA_SILENCE_FACTOR=1.0
OKX_LINK_WS_DATA_SILENCE_MIN_S=120.0
OKX_LINK_WS_DATA_SILENCE_MAX_S=900.0
# 退避复位门槛（根因 B：`send(subscribe)` 之后立刻复位 ⇒「连上就断」被误判成成功 ⇒ 热重连）。
OKX_LINK_WS_HEALTHY_AFTER_S=20.0
OKX_LINK_WS_BACKOFF_BASE_S=1.0
OKX_LINK_WS_BACKOFF_MAX_S=30.0
# 全局建连速率闸，**只作用于重连**；首次建连不取令牌。0 = 不限。
OKX_LINK_WS_CONNECT_RATE_PER_S=2.0
# 公共 REST：错误分级 + 去相关抖动退避 + 单次调用总墙钟预算（含等待）。
OKX_LINK_REST_MAX_ATTEMPTS=4
OKX_LINK_REST_BUDGET_S=25.0
OKX_LINK_PUBLIC_RATE_PER_S=8.0
OKX_LINK_PUBLIC_BURST=4.0
# 私有令牌桶按**账户**独立（多标的分组启动瞬间不至于把私有限频一次打爆）。
OKX_LINK_PRIVATE_RATE_PER_S=5.0
OKX_LINK_PRIVATE_BURST=5.0
# 熔断**只作用于公共读**；私有读写永不熔断。探针类调用（health / 服务器时间 / 补根 / 手动探测）
# 一律豁免且任一次成功即复位冷却——否则熔断会经 okxUp 主动拆掉浏览器行情流，自己制造断线。
# 置 0 即整体关闭熔断。
OKX_LINK_BREAKER_FAILURES=5
OKX_LINK_BREAKER_COOLDOWN_S=20.0
# 私有连接池空闲存活；0 = 用完即关（退化为旧行为）。
OKX_LINK_POOL_IDLE_TTL_S=120.0
# 服务器时钟同步周期；0 = 只在 50102/50104 时同步。
OKX_LINK_CLOCK_SYNC_INTERVAL_S=900.0
# 断线补根上限（只补证据、不补决策）；0 = 不补根。
OKX_LINK_GAP_REPAIR_MAX_BARS=300
# 链路断开多久推一条降级提示（比会话看门狗的 bar×3 快得多；只告警，**不改**平仓语义）。
OKX_LINK_DOWN_ALERT_S=20.0
# 平仓「读回核验」：`close-position` 无去重承诺，传输层异常后**不重试**，改为有界重读持仓。
OKX_LINK_VERIFY_ATTEMPTS=3
OKX_LINK_VERIFY_BACKOFF_S=0.6

# ---- 信任边界（SECURITY_*，trust-boundary-and-signal-integrity D1）----
# 本机 API 的 Origin 白名单，逗号分隔。留空 = 用后端内置默认
# （http://localhost:18761 与 http://127.0.0.1:18761，即 Next 前端的两个等价入口）。
# 显式配置即**完全替换**默认（不做合并，避免「以为收紧了其实没有」）。
# 不接受 * 与 null：前者等于关掉这个开关，后者是 sandboxed iframe 的不透明源——正是要挡的那一类。
# 三条生效路径要分清：
#   · 本文件在**仓库根**，是给人抄的样例；后端真正读的是 services/quant/.env（env_file 相对 CWD）；
#   · **打包后的 PyInstaller 后端完全不读任何 .env**，只读进程 env——桌面端经
#     desktop/src/lib/config.js 的 SECURITY_ 前缀白名单，从 userData/agent.env 注入；
#   · 容器部署经 docker-compose.yml 的 quant 服务透传（远程部署时那是唯一入口）。
SECURITY_ALLOWED_ORIGINS=

# ---- 交易经验的复利化（AI_TRADE_EXPERIENCE_*，ai-trade-experience-compounding §6.2）----
# 三项总闸**各自独立**，理由是回滚粒度：增量物化出问题只需要关增量，不该把效用闭环一并关掉。
# 关掉其中任何一项，该子系统逐字回退到 `8e05dd9` 的对应行为，其余两项不受影响。
#
# 增量物化：False ⇒ 每次都走全量重建（与合入本轮之前**逐值相同**，一键回滚）。
AI_TRADE_EXPERIENCE_INCREMENTAL_ENABLED=true
# 效用闭环：False ⇒ 不写注入台账、不算「注入后表现」、不做自动静音。
AI_TRADE_EXPERIENCE_UTILITY_ENABLED=true
# 接管 / 离线平仓的补采：False ⇒ 这两类往返只计采集缺口、不补采（会保留幸存者偏差）。
AI_TRADE_EXPERIENCE_ADOPT_HARVEST_ENABLED=true

# ---- AI 自动交易 · 方向对称性修复（AI_TRADE_DIRECTIONAL_* / AI_TRADE_CONSENSUS_CONTRARIAN_*，
#      spec ai-trade-directional-symmetry §7.3）----
# 背景：共识门禁的判据 `同向票数 >= min_consensus` **看起来对称**，在单边行情里却只会拦逆势那
# 一侧（信号板必然一边倒 ⇒ 该判据对顺势方向恒成立、对逆势方向恒不成立）。生产回归窗口实测：
# 1540 次开仓意愿里 832 次（54%）死在这一层，同期 41 笔开多 / 0 笔开空。
#
# 总闸：False ⇒ **全仓逐字节回退**到本特性合入前 —— 三处审议 mandate、方向对称宪章第六段、
# 逆势通路、payload 的 `consensus.contrarian` 段、`openFunnel` 的 `bySide`/`directionBalance`、
# `tool_call` 相位的 `layerLabel`、门禁否决注记的泛化、先验单侧去偏、经验 side 轴去偏，全部回退。
AI_TRADE_DIRECTIONAL_SYMMETRY_ENABLED=true
# 逆势通路（共识门禁的方向对称证据通道）。作用域**只有** steady(min_consensus=2) 与
# balanced(1) 两档 —— aggressive 与 off 的 min_consensus 都是 0，共识门禁本就不触发。
AI_TRADE_CONSENSUS_CONTRARIAN_ENABLED=true
# 走逆势通路所需的模型自报置信度下界（(0,1]）。
AI_TRADE_CONSENSUS_CONTRARIAN_MIN_CONFIDENCE=0.65
# 反向票数上限：信号板一边倒得比这更厉害时本通路不开放（>=0）。
AI_TRADE_CONSENSUS_CONTRARIAN_MAX_OPPOSING_VOTES=1
# `contrarianEvidence` 的最小字符数（>=0）。写不满即不放行，且不产生任何新的降级语义。
AI_TRADE_CONSENSUS_CONTRARIAN_MIN_EVIDENCE_CHARS=60
# 单会话逆势试探配额（>=0）。**不落库、冷续跑归零**（配额的语义是「一个会话内」）。
AI_TRADE_CONSENSUS_CONTRARIAN_MAX_PER_SESSION=3
# 逆势放行时的强制降档系数（(0,1]）：仓位 = 原提议 × 本系数，量化后仍 <= 原提议。
AI_TRADE_CONSENSUS_CONTRARIAN_SIZE_MULT=0.5
# 方向分布判「样本不足」的下界。分母**只数方向可辨的开仓意愿**（long+short）；`unknown`
# （置信度门槛在方向可见之前就拦掉的那些轮，实测占 21%）不进分母、也不进任何占比。
AI_TRADE_DIRECTION_BALANCE_MIN_SAMPLES=8

# ---- AI 自动交易 · 执行周期趋势基调（AI_TRADE_TREND_*，
#      spec ai-trade-execution-trend-verdict §6.3）----
# 背景：《审议协议》的第一步此前锚在**高周期**（S1 = 1D → 12H → 4H → 1H；S2 被定义为「对 S1
# 的附议或异议」；S3 明令战术周期不得单独反转 S1），而多周期证据的取数策略是「严格高于执行
# 周期」——用户选 15m 启动，拿到的「整体基调」里一根 15m K 线都没有。于是一段以周为尺度的
# 上涨里，每一轮的第一步都得到「整体=bullish」：「一直在买多」不是模型的偏好，是协议的结构
# 性产物。本层在**用户所选执行周期**上算一份确定性的《趋势基调》，高周期只作权重受限的调制项。
#
# 总闸：False ⇒ **全链路逐字节回退**到本特性合入前（payload / 决策 prompt 的基调段与第七段
# 宪章 / 决策纪律 #1 的读序 / 审议协议 S1·S2·S12 / **复核官的 R4 与两条评级标准** / 逆势降档闸 /
# 两条顺势放宽通路 / trace 两相位新键 / 开仓漏斗的 trendBias 层 / 统计卡，全部回到旧形态）。
AI_TRADE_TREND_VERDICT_ENABLED=true
# 回测侧独立总闸（沿用 horizon / profit_guard 的既有先例）。
AI_TRADE_TREND_VERDICT_BACKTEST_ENABLED=true
# 对称死区：|score|（含高周期调制）达该值才给方向（(0,1]）。
AI_TRADE_TREND_ENTER_THRESHOLD=0.22
# 记 strong 的下界，判据是 |execScore|（**不含**高周期）。解析点夹紧到 > enter + 0.05。
# 强度不含高周期是刻意的：它是下面三条通路唯一的触发条件，让高周期参与它，等于让高周期在
#「日线看多、15m 翻空」这个目标断面上一键关停整个特性。
AI_TRADE_TREND_STRONG_THRESHOLD=0.55
# 高周期调制项权重（[0,0.4]，解析点封顶到 0.30）。它与「执行周期可用权重下界 0.5」一起
# **构造性地**保证高周期永远翻不动执行周期的结论。
AI_TRADE_TREND_HTF_WEIGHT=0.18
# 逆势降档闸（唯一会**减少**成交的那一把；关掉它基调仍进 prompt 与统计，只是不再拦任何一笔）。
AI_TRADE_TREND_COUNTER_GATE_ENABLED=true
# 逆势开仓的置信度下界（(0,1]）。比的是**模型自报**的 decision.confidence，不是基调置信度。
AI_TRADE_TREND_COUNTER_MIN_CONFIDENCE=0.65
# 逆势开仓的强制降档倍数（(0,1]）：量化后仍须严格小于原提议，否则本轮退回观望。
AI_TRADE_TREND_COUNTER_SIZE_MULT=0.5
# 顺势追加一票（D-1a，会**增加**成交）：顺势 + 基调强 + 无冲突 + 该方向已有 ≥1 张原生票
# 才 +1 票，上限恒为 1。它只解决「差一票」，解决不了「信号板一票都没有」。
AI_TRADE_TREND_CONSENSUS_VOTE=true
# 顺势放宽逆势通路的反向票上限 +1（D-1b，会**增加**成交）：它**不发票**，只把
# AI_TRADE_CONSENSUS_CONTRARIAN_MAX_OPPOSING_VOTES 抬高 1；逆势通路的逐字证据、置信度
# 下界、会话配额与强制降档一条不减。它是「板子清一色看多、做空原生票数 0」的唯一出口。
AI_TRADE_TREND_CONTRARIAN_ALLOWANCE=true

# ---- AI 自动交易 · 离场优先级与离场意图兑现（AI_TRADE_EXIT_* / AI_TRADE_MANUAL_EXIT_*，
#      spec ai-trade-exit-priority-and-commitment §5.1）----
# 与持仓周期三闸并列的第四条纪律，极性相同（fail-open）但方向相反：三闸约束「什么时候不许平」，
# 本层约束「什么时候必须让它平」。**只放行平仓，永不放行开仓**（不变式 X-1）。
#
# 总闸：False ⇒ 整层不装配 —— 决策工具 schema 恒等于模块常量、三份 prompt 逐字节回退、
# 离场意图账本回退到「一轮非离场即清零」。
AI_TRADE_EXIT_PRIORITY_ENABLED=true
# 回测侧独立总闸（可跑对照臂）：关 ⇒ 回测里轴 A/B 整层空转，实盘不受影响。
AI_TRADE_EXIT_PRIORITY_BACKTEST_ENABLED=true
# 离场意图账本的衰减容忍轮数；**0 = 一键回退**到「一轮非离场动作即清零」（F-1 的回滚开关）。
# 默认 2 = 只容忍一次犹豫；同向加仓（与离场直接矛盾的动作）一律立即清零，不走衰减。
AI_TRADE_EXIT_INTENT_DECAY_ROUNDS=2
# 离场意图挂起上界 = 本值 x 离场确认窗口；0 ⇒ 关闭该豁免。它是「锁必须有钥匙」的第二把钥匙：
# 一条离场论点在账本上活满上界即解除 G2/G3（**不解 G1**）。
AI_TRADE_EXIT_PENDING_RELEASE_MULT=2.0
# 最高优先级离场（exitConviction=final）要求的跨轮离场意图轮数。
AI_TRADE_EXIT_OVERRIDE_ROUNDS=2
# G1 的不可解除内核：连 override 也不解这一段（挡「开仓当轮立刻 final 平仓」的病态形态）。
AI_TRADE_EXIT_OVERRIDE_MIN_HOLD_S=60.0
# 会话级配额；0 ⇒ 关闭 override 档（final 一律按 high 处理，且如实写进 prompt）。
# 复核官背书放行（adjudicated）与 override **共用**这一份配额，绝不是配额外的第二条通道。
AI_TRADE_EXIT_OVERRIDE_MAX_PER_SESSION=6
# final 必须附带的新证据长度门槛（去空白后字符数）。
AI_TRADE_EXIT_EVIDENCE_MIN_CHARS=10
# close 的下单前反思由 fail-closed 反转为 fail-open：一次 LLM 超时不该锁死一笔真实持仓。
# False ⇒ 逐字回退（F-3 的回滚开关）。模型的**真实** abort 裁决不在反转范围内，永远拦得住。
AI_TRADE_EXIT_REFLECTION_FAIL_OPEN=true
# 离场意图兑现（已确认离场但没成交 ⇒ 下一次盯市重试）总闸；关 ⇒ 整层空转、面板整块不渲染。
AI_TRADE_EXIT_COMMITMENT_ENABLED=true
AI_TRADE_EXIT_COMMITMENT_RETRY_INTERVAL_S=10.0
AI_TRADE_EXIT_COMMITMENT_MAX_ATTEMPTS=6
AI_TRADE_EXIT_COMMITMENT_MAX_AGE_S=300.0
# 【立即离场】运维总闸（人工授权的单次市价离场端点）；关 ⇒ 端点 409，面板按钮**照常渲染**、
# 点下去如实回显那句中文（本值不进任何 wire，前端无从预知它）。
AI_TRADE_MANUAL_EXIT_ENABLED=true

# ---- AI 自动交易 · 行情断连自愈（AI_TRADE_FEED_* / AI_TRADE_MARK_PX_*，
#      spec ai-trade-feed-self-healing §5.2）----
# 今天的行情停滞看门狗只置标志 + 推一句文案，而那个标志是一个**吸收态**：三条唤醒源全被它挡住，
# 而唯一能清它的是那条已经死掉的 WS 自己 —— feed 死 ⇒ 会话降级 ⇒ 唤醒停摆 ⇒ 只有 feed 能解锁。
# 本组把这条链路从「观测」升级为「自愈」（降级 → REST 活性补取 → 强制换链 → 升级告警）。
#
# 整轴总闸：False ⇒ 四处**逐字**回落 —— 判定层只回 clear/degrade/none 三态、成员 lifecycle 的
# feedRecovery **整键缺席**、/relink 端点 409、前端因键缺席而不渲染恢复卡。四处缺一，这个开关
# 就只是一句声明。自愈**绝不**新增自动平仓路径（LIVE_AUTO_FLATTEN_ON_STALE 的语义一字不动）。
AI_TRADE_FEED_SELFHEAL_ENABLED=true
# REST 活性补取冷却（只在**已降级**时才发；正常运行零成本）。
AI_TRADE_FEED_BACKFILL_INTERVAL_S=60.0
# x stale_after（= bar x LIVE_AUTO_STALENESS_FACTOR）才走会话级换链 ⇒ 门槛 = bar x 6，1H 下是
# 6 小时。这不是笔误：常态下的换链触发点是「WS 任务已死 / 链路登记簿判 down」，本门槛只是兜底。
AI_TRADE_FEED_RELINK_FACTOR=2.0
AI_TRADE_FEED_RELINK_MIN_INTERVAL_S=120.0
# 换链几次仍拿不到新根即升级告警、把主动权交回用户；0 = 永不升级（一直自动重试下去）。
AI_TRADE_FEED_ESCALATE_AFTER_RELINKS=3
# 人工【立即重连】的**服务端硬死线**：前端对该路径落 20 秒快超时档，而它最该被点击的场景恰恰
# 是「网络仍不通」。12 秒内必须给出一个诚实回执，绝不让用户在唯一的兜底按钮上读到「结果未知」。
AI_TRADE_FEED_RELINK_DEADLINE_S=12.0
# 盯市判定价的 REST 回落阈值：断流期间直接用最后一根收盘价，会让盯市与会话止盈止损全程吃一个
# 21 小时前的价。判据用**判定价年龄**而不是 K 线年龄（后者在 12H/1D 下几十小时不跳）。0 = 关。
AI_TRADE_MARK_PX_FALLBACK_AFTER_S=180.0

# ---- AI 自动交易 · 深度思维链（AI_TRADE_REASONING_*，spec ai-trade-deep-reasoning-chain §5.3）----
# off | standard | deep | exhaustive；off = 逐字节回退到本特性合入前的浅研判形态
# （prompt、预算、追问、截断码、wire 加法键、超时、重试上限、轮级墙钟闸一并回退）。
AI_TRADE_REASONING_DEPTH=deep
AI_TRADE_REASONING_DEPTH_BACKTEST=standard
AI_TRADE_REASONING_MAX_TOKENS=0
AI_TRADE_REFLECTION_MAX_TOKENS=0
AI_TRADE_SUMMARY_MAX_TOKENS=1536
AI_TRADE_REASONING_RESERVE_TOKENS=768
AI_TRADE_REASONING_MIN_CHARS=-1
AI_TRADE_REASONING_REASK_MAX=1
AI_TRADE_REASONING_PRESSURE_RATIO=0.6
# 单轮墙钟总闸（秒，全部尝试 + 追问共享）；0 = 用档位表的值（deep=600）。
AI_TRADE_REASONING_ROUND_DEADLINE_S=0
# [P0-4] 两个超时**不再**在此改默认。生效口径（见 spec §实施过程发现的方案缺陷 I-4）：
#   深度档生效（standard/deep/exhaustive）⇒ 取档位表的值（150/210/420 与 100/150/240）；
#   off 档 / 未装配深度档     ⇒ 逐字回退到下面这两个值（也就是合入前的 60 / 45）。
# 改这两行**只影响 off 档与未装配路径**；要调深度档的超时请改 AI_TRADE_REASONING_DEPTH 或档位表。
AI_TRADE_DECISION_TIMEOUT_S=60
AI_TRADE_REFLECTION_TIMEOUT_S=45
# Anthropic 扩展思考（0=不启用，请求体逐字节不变；>0 时强制 temperature=1 且移除 top_p）。
AGENT_THINKING_BUDGET_TOKENS=0

# ---- 标的市场情报层（AI_TRADE_INTEL_*，ai-trade-market-intel + intel-closed-loop + intel-evidence-grounding，64 项）----
# 一个与交易 Agent **完全分开**的情报 Agent，为每个正在 AI 自动交易的标的定期检索公开信源，
# 把结果摘要成几句话的短情报、过六道真实性闸后落进本地情报库；另一个整理轮定期回看整座库，
# 自主决定升级 / 降级 / 合并 / 清理。情报**只进 prompt，不进任何确定性门禁**。
#
# 两个运维单键：ENABLED=false ⇒ 不建后台任务、不注册前端按钮、决策 prompt 逐字节回退；
#              INJECT=false  ⇒ 情报照常采集与展示，但一个字都不喂给交易 Agent。
AI_TRADE_INTEL_ENABLED=true
AI_TRADE_INTEL_INJECT=true
# 检索源：tavily / brave / serper 三选一（**单活**，不做多源扇出）；
# none = 未配置 ⇒ 全链路诚实降级（**绝不**让模型凭空生成情报）。
# 库内行（设置中心）优先，本项是 env 回落。
AI_TRADE_INTEL_SEARCH_PROVIDER=none
AI_TRADE_INTEL_SEARCH_API_KEY=
AI_TRADE_INTEL_SEARCH_BASE_URL=
AI_TRADE_INTEL_SEARCH_TIMEOUT_S=12.0
AI_TRADE_INTEL_SEARCH_MAX_RETRIES=2
AI_TRADE_INTEL_COLLECT_INTERVAL_MIN=30.0
AI_TRADE_INTEL_COLLECT_JITTER_PCT=0.15
AI_TRADE_INTEL_CURATE_EVERY_N_COLLECTS=4
AI_TRADE_INTEL_QUERIES_PER_ROUND=4
AI_TRADE_INTEL_DOCS_PER_QUERY=6
AI_TRADE_INTEL_CORPUS_MAX_DOCS=16
AI_TRADE_INTEL_SNIPPET_MAX_CHARS=500
AI_TRADE_INTEL_ITEMS_PER_ROUND=5
# 摘要硬上限：**超出即拒收并计数，绝不静默截断**（工具 schema 故意放宽到 400 字，好让
# 「模型系统性写太长」成为一个可观测的事实）。
AI_TRADE_INTEL_SUMMARY_MAX_CHARS=160
AI_TRADE_INTEL_MAX_TOKENS=3072
AI_TRADE_INTEL_TIMEOUT_S=60.0
AI_TRADE_INTEL_MAX_ACTIVE_ULTRA=40
AI_TRADE_INTEL_MAX_ACTIVE_MID=24
AI_TRADE_INTEL_MAX_ACTIVE_LONG=16
AI_TRADE_INTEL_ULTRA_TTL_H=72.0
AI_TRADE_INTEL_MID_TTL_D=45.0
AI_TRADE_INTEL_LONG_TTL_D=400.0
AI_TRADE_INTEL_PROMOTE_MIN_DOMAINS=2
AI_TRADE_INTEL_PROMOTE_MIN_AGE_MIN=60.0
AI_TRADE_INTEL_CURATE_MAX_ACTIONS=24
AI_TRADE_INTEL_PROMPT_MAX_CHARS=1200
AI_TRADE_INTEL_DAILY_ROUND_CAP=96
AI_TRADE_INTEL_FAIL_BACKOFF_BASE_S=120.0
AI_TRADE_INTEL_FAIL_BACKOFF_MAX_S=3600.0
# 已排期**未来事件**的准入前向窗（天）。0 ⇒ 退回「只收已发生的事件」，届时「今晚的 CPI」
# 「明天的解锁」一条都进不来——而那恰恰是本特性的头号用例。
AI_TRADE_INTEL_FORWARD_WINDOW_D=30.0
# 已排期事件过了 event_ts 多久仍无后续报道即判失效（降级 / 归档），防「永远的明天」堆积。
AI_TRADE_INTEL_LAPSE_GRACE_H=24.0
# 关停时情报后台任务的有界收敛死线。**必须 < SHUTDOWN_STEP_TIMEOUT_S**（启动期校验器钉死）：
# 倒挂时外层先 cancel、内层清理永不执行，后台任务会活着穿过 dispose_engine。
AI_TRADE_INTEL_DRAIN_TIMEOUT_S=5.0
# 情报设置保存后，等待当前这一轮情报跑完的死线（秒）。超时即转后台重装，界面会显示
# 「设置已保存，当前这一轮情报跑完后自动生效」。**必须 < 10.0**（启动期校验器钉死）：
# 客户端 REST 超时档为 20 秒，留一半裕量给往返与写库，否则「保存」按钮会假超时。
AI_TRADE_INTEL_REARM_DEADLINE_S=2.5

# ---- 情报闭环（ai-trade-intel-closed-loop §十一，17 项）----
# 让每一条情报可被引用、可被结算、可被证伪、可被拒绝。三把逐层收窄的运维单键：
#   CITE_ENABLED=false        ⇒ 注入行与决策工具 schema **逐字节**回到 52f466e；
#   ATTRIBUTION_ENABLED=false ⇒ 引用照记、不结算不回写；
#   VERIFY_ENABLED=false      ⇒ 不跑核查轮、不写 verdict。
# 上面的 AI_TRADE_INTEL_ENABLED 仍是最外层总闸。
AI_TRADE_INTEL_CITE_ENABLED=true
AI_TRADE_INTEL_CITE_MAX_REFS=8
AI_TRADE_INTEL_ATTRIBUTION_ENABLED=true
# 注入排序里「被引用过且赚过钱」的有界加分上限（亏钱的不加分、也**不减分**）。
AI_TRADE_INTEL_CITE_SCORE_BONUS=0.15
# 引用明细保留天数；到期由整理轮裁剪，**只删明细不回滚统计列**。
AI_TRADE_INTEL_CITE_RETENTION_D=180.0
AI_TRADE_INTEL_VERIFY_ENABLED=true
AI_TRADE_INTEL_VERIFY_EVERY_N_CURATES=1
AI_TRADE_INTEL_VERIFY_MAX_ITEMS=3
AI_TRADE_INTEL_VERIFY_DOCS_PER_ITEM=4
AI_TRADE_INTEL_VERIFY_MIN_AGE_H=12.0
AI_TRADE_INTEL_VERIFY_RECHECK_H=48.0
AI_TRADE_INTEL_VERIFY_MAX_ATTEMPTS=3
AI_TRADE_INTEL_VERIFY_CONFIRM_BONUS=0.05
AI_TRADE_INTEL_VERIFY_REFUTE_PENALTY=0.5
# 核查 Agent 的输出预算（走 build_intel_llm_client 的第二个 client，不是 run_round 的形参）。
AI_TRADE_INTEL_VERIFY_MAX_TOKENS=2048
# 「更信任此源」的置信度先验。**绝不加 domain_count**——那是来源独立性的分母。
AI_TRADE_INTEL_TRUST_BONUS=0.05
# 拉黑一个域名时是否扫除「全部来源都属于它」的存量条目（归档，可在「已归档」中恢复）。
AI_TRADE_INTEL_BLOCKED_SWEEP_ENABLED=true
# ---- 情报证据接地（ai-trade-intel-evidence-grounding，13 项）----
# 两把逐层收窄的运维单键：READER_ENABLED=false ⇒ 不发任何出网抓取请求、语料块逐字节回到
# 上一轮；QUOTE_MODE=off ⇒ 采集/核查工具 schema 对象恒等回退、闸② 判据逐字节回退。
# 抓取只去搜索源返回的 URL，经两段 SSRF 闸（语法 + 解析）与逐跳复检；请求零 Cookie、零 Referer、
# 零本地事实；抓回的正文只进不可信语料区，一个字都不进决策 prompt。
AI_TRADE_INTEL_READER_ENABLED=true
# 每轮抓前几篇（须 ≤ AI_TRADE_INTEL_CORPUS_MAX_DOCS，启动期校验）。
AI_TRADE_INTEL_READER_TOP_K=6
AI_TRADE_INTEL_READER_TIMEOUT_S=8.0
# 一轮抓取的墙钟总预算（**硬死线**）；耗尽即放弃剩余篇数，绝不阻断轮次。
AI_TRADE_INTEL_READER_ROUND_DEADLINE_S=25.0
AI_TRADE_INTEL_READER_CONCURRENCY=4
# 单篇响应字节上限（**流式判定**：超限那一刻就中断，不是读完再判）。
AI_TRADE_INTEL_READER_MAX_BYTES=1500000
# 手动跟随的跳数上限，**每一跳都重新过完整两段闸**（httpx 自动跟随会绕过我们的闸）。
AI_TRADE_INTEL_READER_MAX_REDIRECTS=3
# 同域名每轮抓取上限（礼貌闸）。
AI_TRADE_INTEL_READER_MAX_PER_DOMAIN=2
# **入库**正文上限（逐字比对用的长版本）。
AI_TRADE_INTEL_READER_BODY_MAX_CHARS=20000
# **进 prompt** 的单篇正文上限（省 token 的短版本）。两个上限刻意不同：比对要全文，prompt 要省。
AI_TRADE_INTEL_CORPUS_BODY_PER_DOC_CHARS=2400
# 正缓存窗（小时）。负缓存是**派生量** min(6h, 本值/12)，不是配置项。
AI_TRADE_INTEL_READER_CACHE_TTL_H=72.0
# 正文缓存表行数上限（整理轮第 6 步的三道闸之一：TTL / 行数 / 字节）。
AI_TRADE_INTEL_READER_CACHE_MAX_ROWS=4000
# 引文要求三态：off = 不要求；soft（默认）= 记录但不强制（准入率相对上一轮只可能上升）；
# strict = 必须附可核对引文，且要求 READER_ENABLED=true（启动期校验）。
AI_TRADE_INTEL_QUOTE_MODE=soft

# ---- 情报可行动化（ai-trade-intel-actionability，18 项）----
# 让情报「及时」（高危情报当场唤醒一次决策）、「有战绩」（历史准确率回流成排序与举证责任）、
# 「会去噪」（互相矛盾的两条成对出现并被整理轮裁决）。三把总闸，任一关闭 ⇒ 对应链路逐字节
# 回到 4b9c352：
#   ALERT_ENABLED=false    ⇒ 不发任何告警 handoff，唤醒链路没有第九种 kind；
#   EFFICACY_ENABLED=false ⇒ 注入排序的第二个加分项不参与运算；
#   CONFLICT_ENABLED=false ⇒ 注入行体与整理轮的工具 schema / 两段 prompt 一起回退。
# 上面的 AI_TRADE_INTEL_ENABLED 仍是最外层总闸。
# ⚠️ 告警的全部权力就是「让 AI 提前被问一次」：它调用的是同一个决策轮，共识门禁、铁律层、
# edge 门禁、仓位层、反思层、离场优先级**全部照跑，一道不绕**。
AI_TRADE_INTEL_ALERT_ENABLED=true
# 影响力门槛（medium|high）。low 不是合法取值：它会让「低影响力恒不告警」这条算术性质失效。
AI_TRADE_INTEL_ALERT_MIN_IMPACT=high
# 可告警的类别（csv，元素须属于 market/sentiment/macro/onchain/project/risk）。空串 = 全类别。
AI_TRADE_INTEL_ALERT_CATEGORIES=risk,macro,project
# 须有逐字原文引证才够格打断一次决策；QUOTE_MODE=off 时在生效值读点自动降级为 false。
AI_TRADE_INTEL_ALERT_REQUIRE_QUOTE=true
AI_TRADE_INTEL_ALERT_MIN_DOMAINS=2
AI_TRADE_INTEL_ALERT_MIN_CONFIDENCE=0.6
# 事件新鲜度上限（分钟）。severity 的衰减分母也是它。
AI_TRADE_INTEL_ALERT_MAX_EVENT_AGE_MIN=180.0
# 同标的两次告警的最小间隔（分钟）与每标的每 UTC 日的 fired 上限：成本与打扰的双封顶。
AI_TRADE_INTEL_ALERT_COOLDOWN_MIN=20.0
AI_TRADE_INTEL_ALERT_DAILY_CAP=6
# 未来事件（今晚的 CPI）是否可告警。默认否——它自然会随墙钟轮进视野，不该在中午打断一次决策。
AI_TRADE_INTEL_ALERT_ALLOW_SCHEDULED=false
# 待处理告警的最长存活（秒）。**必须 ≥ 2 × LIVE_AUTO_POLL_INTERVAL_S**（启动期跨字段校验）：
# 小于它时告警在被盯市 tick 看到之前就过期了，是一个永远不会唤醒的配置且没有任何错误。
AI_TRADE_INTEL_ALERT_PENDING_TTL_S=180.0
# 告警台账保留天数；到期由整理轮顺带裁剪。
AI_TRADE_INTEL_ALERT_RETENTION_D=30.0
AI_TRADE_INTEL_EFFICACY_ENABLED=true
# 层级收缩的伪计数：样本少于它的桶权重恒为 0（「没数据」与「全错」是两件事）。
AI_TRADE_INTEL_EFFICACY_K_MIN=8
# 先验对注入排序的**绝对**封顶。它只改变顺序与举证责任，四个消费点里没有一个是门禁。
AI_TRADE_INTEL_EFFICACY_MAX_WEIGHT=0.25
# 域名信誉的最小样本，低于它一律显示「样本不足」而不是一个假的准确率。
AI_TRADE_INTEL_EFFICACY_MIN_DOMAIN_SAMPLES=3
AI_TRADE_INTEL_CONFLICT_ENABLED=true
# 主题重叠阈值（字符 2-gram 的 Jaccard）。矛盾**绝不被自动裁决**：确定性层没有能力判断两条
# 相反的报道里哪一条为真，它唯一诚实的动作是让矛盾对模型和用户都可见。
AI_TRADE_INTEL_CONFLICT_MIN_OVERLAP=0.35
